[
  {
    "type": "function",
    "name": "propose_plan",
    "description": "Propose a synthetic plan; never execute actions.",
    "strict": true,
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "actions",
        "clarificationFields",
        "evidenceRefs",
        "unresolved",
        "executionAuthorized"
      ],
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "ANSWER",
            "PREVIEW",
            "CLARIFY",
            "REFUSE"
          ]
        },
        "actions": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation",
              "targetIds",
              "fields",
              "dependsOn"
            ],
            "properties": {
              "operation": {
                "type": "string",
                "enum": [
                  "DRAFT_SMS",
                  "DRAFT_EMAIL",
                  "CREATE_EVENT",
                  "UPDATE_EVENT",
                  "CANCEL_EVENT",
                  "CREATE_TASK",
                  "CREATE_NOTE",
                  "READ_CONTACT",
                  "READ_CALENDAR",
                  "READ_TASKS",
                  "READ_OPERATION",
                  "NOOP_DUPLICATE",
                  "RESEARCH_SUMMARY"
                ]
              },
              "targetIds": {
                "type": "array",
                "maxItems": 10,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^syn-[a-z0-9-]+$"
                }
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "value"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "type": "string"
                    }
                  }
                }
              },
              "dependsOn": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "clarificationFields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "evidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^syn-s[0-9]+$"
          }
        },
        "unresolved": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "executionAuthorized": {
          "type": "boolean",
          "const": false
        }
      }
    }
  }
]
