{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://endvera.local/schemas/astra-r0-campaign-identity.schema.json",
  "title": "ENDVERA Advanced Model Revalidation Campaign Identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "campaignId", "createdAt", "sourceProductHead", "specHead"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "CAMPAIGN_IDENTITY" },
    "campaignId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "createdAt": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "sourceProductHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "specHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
  }
}
