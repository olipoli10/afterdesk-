          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "$ref": "#/$defs/path" },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "invariantManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "invariants"],
      "properties": {
        "kind": { "const": "INVARIANT_MANIFEST" },
        "invariants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "critical", "observed", "passed", "evidencePaths", "evidenceSha256"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "critical": { "type": "boolean" },
              "observed": { "type": "boolean" },
              "passed": { "type": ["boolean", "null"] },
              "evidencePaths": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
              "evidenceSha256": { "type": "array", "items": { "$ref": "#/$defs/sha256" } }
            }
          }
        }
      }
    },
    "invariantResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "invariantId", "method", "commandId", "deviceEvidencePath", "deviceEvidenceSha256", "result", "evidencePaths", "evidenceSha256"],
      "properties": {
        "kind": { "const": "INVARIANT_RESULT" },
        "invariantId": { "type": "string", "minLength": 1 },
        "method": { "enum": ["AUTOMATED", "DEVICE"] },
        "commandId": { "type": ["string", "null"], "minLength": 1 },
        "deviceEvidencePath": { "anyOf": [{ "$ref": "#/$defs/path" }, { "type": "null" }] },
        "deviceEvidenceSha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "result": { "enum": ["PASS", "FAIL"] },
        "evidencePaths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
        "evidenceSha256": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sha256" } }
      }
    }
  }
