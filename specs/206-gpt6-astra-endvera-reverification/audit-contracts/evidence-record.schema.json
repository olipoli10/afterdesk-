        "finalTree": { "$ref": "#/$defs/gitSha" },
        "worktreeClean": { "type": "boolean" },
        "validationCommandId": { "type": "string", "minLength": 1 },
        "validationExitCode": { "type": "integer" },
        "evidencePath": { "$ref": "#/$defs/path" },
        "evidenceSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "brainPacket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "createdAt", "startHead", "startTree", "finalHead", "finalTree", "reason", "packetPath", "packetSha256", "includedEvidence"],
      "properties": {
        "kind": { "const": "BRAIN_PACKET" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "startHead": { "$ref": "#/$defs/gitSha" },
        "startTree": { "$ref": "#/$defs/gitSha" },
        "finalHead": { "$ref": "#/$defs/gitSha" },
        "finalTree": { "$ref": "#/$defs/gitSha" },
        "reason": { "type": "string", "minLength": 1 },
        "packetPath": { "$ref": "#/$defs/path" },
        "packetSha256": { "$ref": "#/$defs/sha256" },
