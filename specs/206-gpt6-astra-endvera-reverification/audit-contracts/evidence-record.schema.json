              "candidatePassed": { "type": "boolean" },
              "highRiskRegression": { "type": "boolean" }
            }
          }
        }
      }
    },
    "gradeRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "caseId", "oracleEntrySha256", "baselineOutputSha256", "candidateOutputSha256", "baselineRunPassed", "candidateRunPassed", "baselinePassed", "candidatePassed", "highRiskRegression", "graderContractSha256", "graderCommandId"],
      "properties": {
        "kind": { "const": "GRADE_RECORD" },
        "caseId": { "type": "string", "minLength": 1 },
        "oracleEntrySha256": { "$ref": "#/$defs/sha256" },
        "baselineOutputSha256": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sha256" } },
        "candidateOutputSha256": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sha256" } },
        "baselineRunPassed": { "type": "array", "minItems": 1, "items": { "type": "boolean" } },
        "candidateRunPassed": { "type": "array", "minItems": 1, "items": { "type": "boolean" } },
        "baselinePassed": { "type": "boolean" },
        "candidatePassed": { "type": "boolean" },
        "highRiskRegression": { "type": "boolean" },
        "graderContractSha256": { "$ref": "#/$defs/sha256" },
        "graderCommandId": { "type": "string", "minLength": 1 }
      }
    },
    "budgetAuthority": {
      "type": "object",
