        "providerReconciledCalls": { "$ref": "#/$defs/nonNegativeInteger" },
        "calls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requestId", "profile", "caseId", "startedAt", "inputTokens", "outputTokens", "settledCostUsd", "settledCostCad", "costStatus", "usageSource", "receiptPath", "receiptSha256"],
            "properties": {
              "requestId": { "type": "string", "minLength": 1 },
              "profile": { "enum": ["BASELINE", "CANDIDATE"] },
              "caseId": { "type": "string", "minLength": 1 },
              "startedAt": { "$ref": "#/$defs/timestamp" },
              "inputTokens": { "type": ["integer", "null"], "minimum": 0 },
              "outputTokens": { "type": ["integer", "null"], "minimum": 0 },
              "settledCostUsd": { "type": ["number", "null"], "minimum": 0 },
              "settledCostCad": { "type": ["number", "null"], "minimum": 0 },
              "costStatus": { "enum": ["SETTLED", "UNSETTLED_UNKNOWN"] },
              "usageSource": { "enum": ["MODEL_RESPONSE", "GENERATION_METADATA", "NO_PROVIDER_RECEIPT"] },
              "receiptPath": { "$ref": "#/$defs/path" },
              "receiptSha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "transportFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "provider", "endpoint", "requestId", "commandId", "commandStdoutSha256", "commandStderrSha256", "occurredAt", "category", "redacted", "providerRequestId", "chargeStatus", "description"],
      "properties": {
        "kind": { "const": "TRANSPORT_FAILURE" },
        "provider": { "const": "OPENROUTER" },
        "endpoint": { "type": "string", "minLength": 1 },
