        "plannedStabilityRepetitions": { "type": "integer", "minimum": 1 },
        "models": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["profile", "model", "maxInputTokens", "maxOutputTokens", "inputUsdPerMillionTokens", "outputUsdPerMillionTokens", "plannedCalls", "maxRetries"],
