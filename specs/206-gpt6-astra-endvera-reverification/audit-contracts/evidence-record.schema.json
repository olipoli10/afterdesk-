              "profile": { "enum": ["BASELINE", "CANDIDATE"] },
              "model": { "type": "string", "minLength": 1 },
              "maxInputTokens": { "type": "integer", "minimum": 1 },
              "maxOutputTokens": { "type": "integer", "minimum": 1 },
              "inputUsdPerMillionTokens": { "$ref": "#/$defs/nonNegativeNumber" },
              "outputUsdPerMillionTokens": { "$ref": "#/$defs/nonNegativeNumber" },
              "plannedCalls": { "type": "integer", "minimum": 1 },
              "maxRetries": { "$ref": "#/$defs/nonNegativeInteger" }
            }
          }
        }
      }
    },
    "costReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "provider", "providerCalls", "settlementStatus", "unsettledCallCount", "settledSpendCad", "maxObservedCallCad", "providerReconciliationStatus", "providerReconciledCalls", "calls"],
      "properties": {
        "kind": { "const": "COST_RECEIPT" },
