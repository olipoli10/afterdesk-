        "authorizedAt": { "$ref": "#/$defs/timestamp" },
        "authorityEvidencePath": { "$ref": "#/$defs/path" },
        "authorityEvidenceSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "pricingEvidence": {
      "type": "object",
