        "commandId": { "type": "string", "minLength": 1 },
        "commandStdoutSha256": { "$ref": "#/$defs/sha256" },
        "commandStderrSha256": { "$ref": "#/$defs/sha256" },
        "occurredAt": { "$ref": "#/$defs/timestamp" },
        "category": { "enum": ["DNS", "TLS", "TIMEOUT", "HTTP_REJECT", "CONNECTION_RESET", "OTHER"] },
        "redacted": { "const": true },
        "providerRequestId": { "type": "null" },
        "chargeStatus": { "const": "UNSETTLED_UNKNOWN" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "incidentEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "incidentId", "observedAt", "categories", "phase", "providerCallsCompleted", "campaignStopped", "redacted", "containsSecretMaterial", "description", "evidencePaths", "evidenceSha256"],
      "properties": {
        "kind": { "const": "INCIDENT_EVIDENCE" },
        "incidentId": { "type": "string", "minLength": 1 },
        "observedAt": { "$ref": "#/$defs/timestamp" },
        "categories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["UNAUTHORIZED_TRANSPORT", "CUSTOMER_DATA", "SECRET_LEAK", "MODEL_MISMATCH", "BUDGET_BREAKER", "PROVIDER_FAILURE", "SECURITY_CONTROL_FAILURE", "OTHER"] } },
        "phase": { "enum": ["G0", "G1", "G2", "G3", "G4", "G5", "G6", "G7"] },
        "providerCallsCompleted": { "$ref": "#/$defs/nonNegativeInteger" },
        "campaignStopped": { "type": "boolean" },
        "redacted": { "const": true },
        "containsSecretMaterial": { "const": false },
        "description": { "type": "string", "minLength": 1 },
        "evidencePaths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
        "evidenceSha256": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sha256" } }
      }
    },
    "brainCheckpoint": {
      "type": "object",
      "additionalProperties": false,
