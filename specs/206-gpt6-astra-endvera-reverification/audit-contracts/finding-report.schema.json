{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://endvera.local/schemas/astra-r0-finding-report.schema.json",
  "title": "ENDVERA Advanced Model Revalidation Finding Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "auditLane",
    "sourceProductHead",
    "auditor",
    "status",
    "summary",
    "findings",
    "unknowns"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "auditLane": {
      "enum": [
        "CANON_PROVENANCE",
        "ARCHITECTURE_SECURITY",
        "MOBILE_UX",
        "PRODUCT_COVERAGE"
      ]
    },
    "sourceProductHead": {
      "const": "f7bef0ae593fd9ac70a065f76655e692cad61766"
    },
    "auditor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestedModel", "reportedModel", "clientVersion", "campaignId", "observedHead", "observedTree", "runAt", "commandId", "promptPath", "promptSha256"],
      "properties": {
        "requestedModel": { "type": "string", "minLength": 1 },
        "reportedModel": { "const": null },
        "clientVersion": { "type": "string", "minLength": 1 },
        "campaignId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "observedHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "observedTree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "runAt": { "type": "string", "format": "date-time" },
        "commandId": { "type": "string", "minLength": 1 },
        "promptPath": { "type": "string", "minLength": 1 },
        "promptSha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
      }
    },
    "status": {
      "enum": ["PASS_NO_FINDINGS", "FINDINGS", "INCOMPLETE"]
    },
    "summary": { "type": "string", "minLength": 1 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "classification",
          "severity",
          "title",
          "invariant",
          "expected",
          "actual",
          "evidence",
          "reproduction",
          "impact",
          "confidence",
          "proposedTest",
          "mutationAuthorized"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ASTRA-R0-(CANON|ARCH|MOBILE|PRODUCT)-[0-9]{3}$"
          },
          "classification": { "enum": ["FACT", "INFERENCE", "UNKNOWN"] },
          "severity": { "enum": ["P0", "P1", "P2", "P3"] },
          "title": { "type": "string", "minLength": 1 },
          "invariant": { "type": "string", "minLength": 1 },
          "expected": { "type": "string", "minLength": 1 },
          "actual": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "lineStart", "lineEnd", "observation"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "lineStart": { "type": "integer", "minimum": 1 },
                "lineEnd": { "type": "integer", "minimum": 1 },
                "observation": { "type": "string", "minLength": 1 }
              }
            }
          },
          "reproduction": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "command", "exitCode", "outputExcerpt"],
            "properties": {
              "status": { "enum": ["REPRODUCED", "NOT_REPRODUCED", "NOT_RUN"] },
              "command": { "type": ["string", "null"] },
              "exitCode": { "type": ["integer", "null"] },
              "outputExcerpt": { "type": ["string", "null"] }
            },
            "allOf": [
              {
                "if": {
                  "properties": { "status": { "const": "REPRODUCED" } },
                  "required": ["status"]
                },
                "then": {
                  "properties": {
                    "command": { "type": "string", "minLength": 1 },
                    "exitCode": { "type": "integer" },
                    "outputExcerpt": { "type": "string", "minLength": 1 }
                  }
                }
              }
            ]
          },
          "impact": { "type": "string", "minLength": 1 },
          "confidence": { "enum": ["LOW", "MODERATE", "HIGH"] },
          "proposedTest": { "type": "string", "minLength": 1 },
          "mutationAuthorized": { "const": false }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "PASS_NO_FINDINGS" } },
        "required": ["status"]
      },
      "then": {
        "properties": { "findings": { "maxItems": 0 } }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "FINDINGS" } },
        "required": ["status"]
      },
      "then": {
        "properties": { "findings": { "minItems": 1 } }
      }
    },
    {
      "if": {
        "properties": { "auditLane": { "const": "CANON_PROVENANCE" } },
        "required": ["auditLane"]
      },
      "then": {
        "properties": {
          "findings": {
            "items": {
              "properties": { "id": { "pattern": "^ASTRA-R0-CANON-[0-9]{3}$" } }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "auditLane": { "const": "ARCHITECTURE_SECURITY" } },
        "required": ["auditLane"]
      },
      "then": {
        "properties": {
          "findings": {
            "items": {
              "properties": { "id": { "pattern": "^ASTRA-R0-ARCH-[0-9]{3}$" } }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "auditLane": { "const": "MOBILE_UX" } },
        "required": ["auditLane"]
      },
      "then": {
        "properties": {
          "findings": {
            "items": {
              "properties": { "id": { "pattern": "^ASTRA-R0-MOBILE-[0-9]{3}$" } }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "auditLane": { "const": "PRODUCT_COVERAGE" } },
        "required": ["auditLane"]
      },
      "then": {
        "properties": {
          "findings": {
            "items": {
              "properties": { "id": { "pattern": "^ASTRA-R0-PRODUCT-[0-9]{3}$" } }
            }
          }
        }
      }
    }
  ]
}
