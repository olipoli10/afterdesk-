# PostgreSQL. DIRECT_URL must bypass transaction poolers for migrations.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/second_shift
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/second_shift

# Authentication and canonical application origin.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Google sign-in (omit both values to disable it).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required only for `npm run db:seed`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Anthropic intake chat. The pricing model itself is admin-configurable
# (Settings.pricingModel, defaults to claude-opus-5) — AI_MODEL here is
# only the intake chat's model, a separate feature.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# Voyage embeddings for AI pricing suggestions (src/lib/pricing-ai.ts).
# Without this, task submission behaves exactly as it always has —
# admin prices manually, the AI suggestion card just never fills in.
# Get a key at voyageai.com (free tier: 200M tokens).
VOYAGE_API_KEY=

# Stripe Checkout and signed webhook delivery.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend notification and verification mail.
RESEND_API_KEY=
EMAIL_FROM=Second Shift <notifications@example.com>

# Scheduled POST /api/cron/maintenance.
CRON_SECRET=replace-with-a-long-random-secret

# Production is fail-closed unless FILE_SCAN_MODE=optional is explicitly set.
FILE_SCAN_MODE=required
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# File storage. Without these, dev falls back to local disk (./storage) —
# fine for `npm run dev`, but a serverless host's filesystem does not
# persist between requests, so all four must be set in production or the
# app refuses to start (see src/lib/storage.ts). Create a private R2
# bucket + API token at dash.cloudflare.com -> R2 -> Manage R2 API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
