# PostgreSQL. DIRECT_URL must bypass transaction poolers for migrations.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/second_shift
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/second_shift

# Authentication and canonical application origin.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Google sign-in (omit both values to disable it).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required only for `npm run db:seed`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Anthropic intake chat. The pricing model itself is admin-configurable
# (Settings.pricingModel, defaults to claude-opus-5) — AI_MODEL here is
# only the intake chat's model, a separate feature.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# Voyage embeddings for AI pricing suggestions (src/lib/pricing-ai.ts).
# Without this, task submission behaves exactly as it always has —
# admin prices manually, the AI suggestion card just never fills in.
# Get a key at voyageai.com (free tier: 200M tokens).
VOYAGE_API_KEY=

# Stripe Checkout and signed webhook delivery.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend notification and verification mail.
RESEND_API_KEY=
EMAIL_FROM=AfterDesk <notifications@example.com>

# Scheduled POST /api/cron/maintenance.
CRON_SECRET=replace-with-a-long-random-secret

# Internal MCP gateway. Required before /api/mcp/afterdesk is reachable;
# ChatGPT must send it as Authorization: Bearer <token>. Generate a long,
# random value and keep it server-side — never expose it to browser code.
AFTERDESK_MCP_TOKEN=replace-with-a-long-random-secret

# Optional model overrides for the AfterDesk Core registry. Keep the defaults
# until a benchmark justifies a change; every call remains provider-metered.
AFTERDESK_PLANNING_MODEL=claude-sonnet-5
AFTERDESK_EXECUTION_MODEL=claude-haiku-4-5
AFTERDESK_REVIEW_MODEL=claude-sonnet-5

# Malware scanning. FILE_SCAN_MODE=required forces scanning outside
# production too; NODE_ENV=production forces it regardless of this value —
# production is always fail-closed, the two conditions are ORed, not one
# gating the other.
FILE_SCAN_MODE=required

# Cloudmersive Virus Scan API (api.cloudmersive.com) — every client/worker
# upload and admin recheck is scanned here over HTTPS before storage. A
# self-hosted clamd cannot be reached from Vercel Functions (no TLS, no
# auth, expects a trusted local network); this replaces it. Requires a plan
# whose per-file limit covers this app's own upload cap (25 MB default,
# settings.maxFileSizeMB) — the free tier does not (~3.5 MB). Get a key at
# cloudmersive.com.
CLOUDMERSIVE_API_KEY=

# File storage. Without these, dev falls back to local disk (./storage) —
# fine for `npm run dev`, but a serverless host's filesystem does not
# persist between requests, so all four must be set in production or the
# app refuses to start (see src/lib/storage.ts). Create a private R2
# bucket + API token at dash.cloudflare.com -> R2 -> Manage R2 API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# AfterDesk's OWN daily provider-spend ceiling, in integer microdollars
# (1_000_000 = $1.00). This is the account-level circuit breaker: before any
# billable Anthropic call dispatches, committed exposure + this attempt's
# worst case must fit under this number, atomically (src/server/account-spend.ts).
#
# FAILS CLOSED IN PRODUCTION. If this is unset or invalid while
# NODE_ENV=production, every billable call is REFUSED and automated steps
# demote to human work — a missing ceiling must never silently mean "no limit".
# Outside production an unset value simply leaves the ceiling unenforced.
#
# The window is a UTC CALENDAR DAY. Every Anthropic-side spend cap is per
# calendar MONTH, so do not mirror this value into the Console: a monthly cap
# needs to be roughly 31x this to let the application be the first brake.
# R5.2: covers EVERY billable AI provider call the application makes —
# workflow primitives, Phase 1A, client intake chat, the worker assistant,
# admin closed-job analysis and Voyage embeddings.
ACCOUNT_PROVIDER_SPEND_CEILING_MICROS=

# Per-provider form (preferred). A single shared ceiling across providers
# would be a false safety claim: it would permit its full value to EACH
# provider independently. Anthropic falls back to the un-suffixed variable
# above when this one is absent, so existing deployments keep working.
ACCOUNT_PROVIDER_SPEND_CEILING_ANTHROPIC_MICROS=
ACCOUNT_PROVIDER_SPEND_CEILING_VOYAGE_MICROS=

# Voyage's per-million-token rate, in microdollars, supplied by the OPERATOR
# from Voyage's current published pricing. This repository deliberately
# contains no Voyage rate: inventing a plausible constant would put a
# fabricated number into a ledger whose whole value is that its numbers are
# real (see src/lib/embeddings.ts).
#
# CONSEQUENCE IF UNSET: in production the embedding call is NOT made, because
# an unmeterable billable call cannot be reserved for honestly. The task still
# submits; it simply gets no AI pricing suggestion and the admin prices it
# manually — the same state as having no VOYAGE_API_KEY at all.
VOYAGE_EMBEDDING_MICROS_PER_MILLION_TOKENS=
