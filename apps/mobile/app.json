{
  "expo": {
    "name": "ENDVERA",
    "slug": "endvera-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "endvera",
    "userInterfaceStyle": "dark",
    "locales": {
      "fr": "./locales/fr.json",
      "en": "./locales/en.json"
    },
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "ai.endvera.mobile",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "android": {
      "package": "ai.endvera.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#09090b",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#09090b",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Permettre à ENDVERA d’enregistrer uniquement la note vocale que vous choisissez."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
