{
  "expo": {
    "name": "ENDVERA",
    "slug": "endvera",
    "owner": "endveras-team",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "endvera",
    "userInterfaceStyle": "dark",
    "locales": {
      "fr": "./locales/fr.json",
      "en": "./locales/en.json"
    },
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "ai.endvera.mobile",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "android": {
      "package": "ai.endvera.mobile",
      "versionCode": 2,
      "blockedPermissions": [
        "android.permission.READ_SMS",
        "android.permission.WRITE_SMS",
        "android.permission.READ_CALL_LOG",
        "android.permission.WRITE_CALL_LOG",
        "android.permission.WRITE_CONTACTS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#09090b",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#09090b",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Permettre à ENDVERA d’enregistrer uniquement la note vocale que vous choisissez."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Permettre à ENDVERA de voir les contacts que vous choisissez d’utiliser avec votre assistant."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Permettre à ENDVERA de lire votre horaire et de préparer les changements de calendrier que vous demandez.",
          "writeOnlyCalendarPermission": "Permettre à ENDVERA d’ajouter les rendez-vous que vous approuvez à votre calendrier.",
          "remindersPermission": false,
          "writeOnlyAccess": false
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "a7b2c087-f8e1-48e4-8798-f6fabefb69fe"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
