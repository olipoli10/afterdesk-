// AfterDesk — task marketplace V1
// Postgres. All timestamps UTC. All money in integer cents.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // Pooled connection for the running app.
  url        = env("DATABASE_URL")
  // Unpooled connection for migrations: the migration engine uses prepared
  // statements, which a transaction pooler (pgbouncer) breaks.
  directUrl  = env("DIRECT_URL")
  // Pricing-reference embeddings (TaskEmbedding, below). Confirmed working
  // on both managed Postgres and the local PGlite dev server (0.8.1) before
  // this was added — see the commit that introduced AI pricing suggestions.
  extensions = [vector]
}

// ---------- Enums ----------

enum Role {
  CLIENT
  VA
  ADMIN
}

// 14 states: the spec's original 12 plus awaiting_payment and disputed, both
// approved by the operator when the prepayment + dispute model was added.
// Do not add states without telling the operator.
enum TaskStatus {
  submitted
  pricing_review
  quoted
  awaiting_payment // client accepted; task is NOT in the pool until paid
  declined
  open
  claimed
  submitted_for_qc
  qc_rejected
  revision_requested
  completed
  disputed // client escalated within the post-delivery window
  cancelled
  expired
}

/**
 * How many closely-comparable APPROVED reference tasks backed the AI's
 * suggestion — set server-side from the retrieval result, never trusted
 * from the model's own self-report alone (see pricing-ai.ts: zero close
 * matches forces "low" regardless of what the model returns).
 */
enum AiConfidence {
  low
  medium
  high
}

enum TaskTier {
  standard
  high_value
}

enum VaStatus {
  pending_test
  pending_grading
  approved
  rejected
  suspended
}

enum FileKind {
  input
  deliverable
}

enum FileScanStatus {
  pending
  clean
  rejected
  error
}

enum QcStatus {
  pending
  approved
  rejected
  superseded
}

enum TestStatus {
  pending_grading
  approved
  rejected
}

enum PaymentKind {
  va_payout
  client_payment
}

enum PaymentMethod {
  card
  wire
  other
}

enum PaymentStatus {
  pending
  // Card is authorized (Stripe holds the amount) but not yet captured — no
  // money has actually moved, and no ledger "sale" entry exists yet. Set by
  // checkout.session.completed under capture_method: manual.
  authorized
  // Actually captured: money is in AfterDesk's account and a ledger "sale"
  // entry exists. Set only when the capture_client_payment money intent
  // succeeds (src/server/money-intents.ts), which fires on QC approval.
  received
  // An authorization that was voided before it was ever captured — a
  // cancelled task, or a dispute upheld before QC approval happened. Never
  // touched real money, so this is distinct from `refunded`.
  cancelled
  refunded
  partially_refunded
  chargeback
}

enum PayoutStatus {
  owed
  released
  paid
  void
  failed
}

enum DisputeOutcome {
  pending
  rejected // normal task variance — worker paid, client pays
  rework // worker error — sent back to fix
  upheld // worker error, unrecoverable — client refunded, worker unpaid
}

/**
 * Queued money instruction. Written inside the state transaction; drained by
 * the scheduled endpoint. Nothing calls Stripe or Wise from a server action.
 */
enum MoneyIntentKind {
  refund_client
  release_payout
  void_payout
  // Captures a held Stripe authorization for real — the client's card is
  // actually charged now. Enqueued by admin-qc.ts approveDeliverable, in
  // the same transaction that releases the worker's payout, so a capture
  // and a payout release always originate from the same "this delivery is
  // final" decision.
  capture_client_payment
  // Voids a Stripe authorization that was never captured (task cancelled,
  // or a dispute upheld, before QC approval ever triggered a capture).
  // Distinct from refund_client, which reverses money that actually moved.
  cancel_authorization
}

enum MoneyIntentStatus {
  queued
  processing
  done
  failed
}

enum LedgerKind {
  sale
  refund
  payout
  fee
  chargeback
  chargeback_reversal
  correction
}

enum StandingCapacityStatus {
  active
  paused
  cancelled
}

// ---------- Auth (Better Auth owns these shapes) ----------

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  // Locked server-side (input: false in Better Auth config) — never client-assignable.
  role          Role     @default(CLIENT)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions        Session[]
  accounts        Account[]
  vaProfile       VaProfile?
  clientTasks     Task[]           @relation("ClientTasks")
  claimedTasks    Task[]           @relation("ClaimedTasks")
  submissions     Submission[]
  testSubmissions TestSubmission[]
  notifications   Notification[]
  payouts         Payout[]
  examAttempts    ExamAttempt[]
  certifications  Certification[]

  // One standing capacity block per client — see StandingCapacityAccount.
  standingCapacityAccount     StandingCapacityAccount?     @relation("StandingCapacityAccountClient")
  standingCapacityAssignments StandingCapacityAssignment[] @relation("StandingCapacityAssignmentWorker")
  accountContextNotesAuthored AccountContextNote[]         @relation("AccountContextNoteAuthor")
  standingCapacityPayouts     StandingCapacityPayout[]     @relation("StandingCapacityPayoutWorker")
  assistantMessages           AssistantMessage[]
}

/**
 * One graded run at a course exam. Course content and the answer key live in
 * code (src/lib/academy) — the database records only who answered what and
 * the grade, so a content edit can never orphan an attempt.
 */
model ExamAttempt {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseSlug String
  /// Correct answers out of `total`, graded server-side against the key in code.
  score      Int
  total      Int
  passed     Boolean
  /// The chosen option index per question, in question order.
  answers    Json
  createdAt  DateTime @default(now())

  @@index([userId, courseSlug, createdAt])
}

/// Earned once per (worker, course) on the first passing attempt. Never revoked
/// by a retake — a certificate is a fact about a date, not a rolling state.
model Certification {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseSlug String
  earnedAt   DateTime @default(now())

  @@unique([userId, courseSlug])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

// Better Auth's database-backed rate limiter (survives restarts, shared
// across instances).
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

// ---------- VA ----------

model VaProfile {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                 VaStatus  @default(pending_test)
  timezone               String    @default("Asia/Manila")
  // 30-day retake cooldown anchor; admin can override.
  rejectedAt             DateTime?
  cooldownOverride       Boolean   @default(false)
  suspendedAt            DateTime?
  suspensionReason       String?
  // Application evidence reviewed by the operator before pool access. Kept
  // on the private profile only; none of these fields reach clients.
  experienceSummary      String?
  specialties            String?
  weeklyAvailability     String?
  portfolioUrl           String?
  applicationSubmittedAt DateTime?
  // Reliability record
  tasksCompleted         Int       @default(0)
  tasksAbandoned         Int       @default(0)
  deadlinesMissed        Int       @default(0)
  qcRejections           Int       @default(0)
  // Rolling score cache (last N ratings; N = settings.scoreWindow). Source of truth = Submission.rating.
  scoreCache             Float?
  ratedCount             Int       @default(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

// ---------- Tasks ----------

model Task {
  id          String     @id @default(cuid())
  clientId    String
  client      User       @relation("ClientTasks", fields: [clientId], references: [id], onDelete: Restrict)
  title       String
  description String
  quantity    String?
  tier        TaskTier   @default(standard)
  status      TaskStatus @default(submitted)

  // Set by the admin at pricing time. Required before a quote can be sent:
  // category drives the dispute criteria grid and the per-category medians,
  // estimatedMinutes bounds what a fair payout looks like.
  categoryId       String?
  category         TaskCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  estimatedMinutes Int?

  // Operator's own practice work. Frozen once the task leaves pricing_review
  // (enforced by trigger) so it can never become a retroactive delete button
  // on published numbers. Excluded from client-side public figures only —
  // a real payout to a real worker always counts.
  isInternal Boolean @default(false)

  // RULE 2 — two independent prices. Exposure is controlled exclusively
  // through the role-shaped selects in src/lib/queries/. clientPriceCents is
  // NEVER selected in any VA-facing query; vaPayoutCents NEVER in any
  // client-facing query.
  currency         String @default("USD")
  clientPriceCents Int?
  vaPayoutCents    Int?

  // AI pricing suggestion (internal — admin only, client and worker never
  // see any of this). Computed once, at submission (src/server/actions/
  // client-tasks.ts), so the pricing queue has something to sort
  // confidence on before the admin ever opens a task — never lazily on
  // page load. aiLowCents/aiHighCents/aiReasoning predate this feature and
  // are reused as-is (price_range_low / price_range_high / reasoning from
  // the model's structured output); everything below is new.
  aiLowCents  Int?
  aiHighCents Int?
  aiReasoning String?

  // RULE 2 applies here too: aiSuggestedPriceCents and
  // aiSuggestedVaPayoutCents are two independent model outputs, never one
  // derived from the other — same separation the human-entered
  // clientPriceCents/vaPayoutCents above already enforce.
  aiSuggestedPriceCents    Int?
  aiSuggestedVaPayoutCents Int?
  aiConfidence             AiConfidence?
  aiEstimatedMinutes       Int?
  // A hint only — the category select in the pricing form is still
  // required and still the admin's own call. Stored as a slug rather than
  // a relation: an unrecognized or stale slug should just fail to
  // highlight anything in the UI, never block pricing.
  aiSuggestedCategorySlug  String?
  // Null while the suggestion is still being computed (or was skipped —
  // ANTHROPIC_API_KEY/VOYAGE_API_KEY not configured) vs. genuinely absent;
  // the queue UI tells those two states apart on this alone.
  aiComputedAt             DateTime?

  // Deadlines: client-facing vs VA-facing (client minus QC buffer). Both stored. UTC.
  clientDeadlineUtc DateTime?
  vaDeadlineUtc     DateTime?

  quotedAt             DateTime?
  quoteExpiresAt       DateTime?
  acceptedAt           DateTime?
  claimedById          String?
  claimedBy            User?     @relation("ClaimedTasks", fields: [claimedById], references: [id], onDelete: Restrict)
  claimedAt            DateTime?
  completedAt          DateTime?
  revisionWindowEndsAt DateTime?
  // Escrow dispute window (settings.disputeWindowHours, default 48h), set at
  // QC approval alongside revisionWindowEndsAt but tracked independently: it
  // gates when the client's authorized payment gets captured and the
  // worker's payout gets released (releaseDisputeWindowFunds in sweeps.ts),
  // not when a revision can be requested. Paused/resumed by the same
  // windowPausedAt as revisionWindowEndsAt — a dispute suspends both.
  disputeWindowEndsAt DateTime?
  declinedAt           DateTime?
  declineReason        String?
  cancelledAt          DateTime?
  cancelReason         String?
  expiredAt            DateTime?

  // Payment gate: quoted -> awaiting_payment -> open. Its own clock, distinct
  // from quoteExpiresAt (which measures how long the client has to decide).
  paymentDueAt DateTime?

  // Post-delivery window. revisionWindowEndsAt is the authoritative deadline;
  // a revision pauses it (windowPausedAt) and the paused duration is added
  // back on return, with a floor so reworked files always get a real look.
  // firstCompletedAt is immutable: audit anchor + hard ceiling on the loop.
  firstCompletedAt     DateTime?
  windowPausedAt       DateTime?
  revisionRounds       Int       @default(0)
  // Operator-authored, identity-safe instructions shown to the worker. The
  // client's raw revision/dispute text stays in TaskEvent/Dispute (admin only).
  revisionInstructions String?

  qcRounds      Int     @default(0)
  filesVerified Boolean @default(false)

  // Set only for a task submitted inside a Standing Capacity block (RULE 5 in
  // this feature's design notes). When set: clientPriceCents/vaPayoutCents
  // stay null (the price was already fixed at the block level, never per
  // task), the task skips pricing/quoting/payment entirely (submitted ->
  // claimed is a legal edge only for this case — see src/lib/state.ts), and
  // it is claimed directly by the account's current assignment, never
  // through the public pool.
  standingCapacityAccountId String?
  standingCapacityAccount   StandingCapacityAccount? @relation(fields: [standingCapacityAccountId], references: [id], onDelete: Restrict)

  filesPurgedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  files        File[]
  submissions  Submission[]
  events       TaskEvent[]
  // Lists, not single rows: a task can be paid then refunded, and a
  // chargeback can arrive months later. At most one dispute may be OPEN at a
  // time — enforced by a partial unique index in the migration, not here.
  payments     Payment[]
  payouts      Payout[]
  disputes     Dispute[]
  moneyIntents MoneyIntent[]
  embeddingRow TaskEmbedding?
  closedJobLog ClosedJobLog?

  @@index([status])
  @@index([clientId])
  @@index([claimedById])
  @@index([categoryId])
  @@index([standingCapacityAccountId])
}

/**
 * Closed, admin-editable taxonomy. A real table, not a Setting blob, because
 * ledger rows reference it permanently. Clients never self-select — the party
 * that benefits from a category must not choose it.
 */
model TaskCategory {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  /**
   * What counts as delivered, and the tolerated error margin. Shown to the
   * client at quote time and to the worker before they claim, so a dispute is
   * checked against a written standard instead of judged by mood.
   */
  disputeCriteria String?
  /**
   * Admin-set market reference rate (cents/hour) for the public MONEY SAVED
   * counter: (referenceHourlyRateCents/100 * hours) - clientPriceCents,
   * floored at 0 per task. Null means this category is simply excluded from
   * the counter rather than treated as a zero rate — an undefined comparison
   * must never silently read as "no savings." See src/lib/queries/public-stats.ts.
   */
  referenceHourlyRateCents Int?
  sortOrder       Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tasks Task[]
}

/**
 * One embedding per task, generated once from title+description when the AI
 * pricing suggestion first runs (src/lib/pricing-ai.ts) — whether or not
 * that task ever gets approved. A task becomes usable as a REFERENCE for
 * some later task's retrieval only once it has a real clientPriceCents /
 * vaPayoutCents (enforced in the retrieval query, not by anything here);
 * until then its embedding just sits here unused, which is fine — it means
 * the day it IS approved, no backfill is needed.
 * A separate table rather than a column on Task: the vector only matters to
 * one query (nearest-neighbor retrieval), and keeping it off the hot Task
 * table means every ordinary Task read stays exactly as cheap as before
 * this feature existed.
 * Unsupported("vector(1024)") because Prisma's schema language has no
 * native pgvector type; every read/write against this column goes through
 * $queryRaw/$executeRaw in src/lib/pricing-ai.ts. 1024 = the output
 * dimension of the Voyage embedding model pricing-ai.ts calls — the two
 * must be changed together or every existing row's dimension stops
 * matching new ones.
 */
model TaskEmbedding {
  taskId    String                      @id
  task      Task                        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  embedding Unsupported("vector(1024)")
  createdAt DateTime                    @default(now())
}

// One QC decision per submission attempt (a delivery may contain several files).
model Submission {
  id          String    @id @default(cuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  vaId        String
  va          User      @relation(fields: [vaId], references: [id], onDelete: Restrict)
  attemptNo   Int
  note        String?
  /**
   * Closed-schema delivery metrics, hardcoded per category in
   * src/lib/delivery-metrics.ts and validated by zod on write AND on read.
   * Integers and fixed enums only, never free text: unlike `note`, this is
   * shown to the paying client once the delivery has been approved, so the
   * RULE 1 argument that keeps `note` unprojected has to be structural here.
   * NULL means the category has no metrics schema, or the delivery predates
   * this column. An empty object would read as "zero records handled".
   */
  deliveryMetrics Json?
  qcStatus    QcStatus  @default(pending)
  qcComment   String?
  rating      Int? // 1-5, set at QC approval
  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?

  files File[]

  @@unique([taskId, attemptNo])
  @@index([qcStatus])
  @@index([vaId])
}

model File {
  id           String         @id @default(cuid())
  // Nullable until attached: upload happens first (ticket pattern), the
  // submit action claims the file by checking uploaderId and setting taskId.
  taskId       String?
  task         Task?          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submissionId String?
  submission   Submission?    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  kind         FileKind
  uploaderId   String
  storageKey   String         @unique
  fileName     String
  mime         String
  sizeBytes    Int
  // Uploads are unavailable until their declared type, byte signature and
  // malware scan all pass. `sha256` also makes incident response and
  // duplicate-malware blocking possible without retaining the raw upload.
  scanStatus   FileScanStatus @default(pending)
  detectedMime String?
  sha256       String?
  scanDetails  String?
  scannedAt    DateTime?
  createdAt    DateTime       @default(now())
  purgedAt     DateTime?

  accessLogs FileAccessLog[]

  @@index([taskId])
  @@index([uploaderId])
  @@index([scanStatus])
}

model FileAccessLog {
  id        String   @id @default(cuid())
  fileId    String
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  userId    String
  action    String // "download" | "upload"
  createdAt DateTime @default(now())

  @@index([fileId])
}

// Audit log — one row per state change / notable admin action, written inside
// the same transaction as the change itself.
model TaskEvent {
  id         String      @id @default(cuid())
  taskId     String
  task       Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromStatus TaskStatus?
  toStatus   TaskStatus?
  action     String
  actorId    String?
  reason     String?
  meta       Json?
  createdAt  DateTime    @default(now())

  @@index([taskId])
}

// ---------- Entry test ----------

model TestQuestion {
  id      String  @id @default(cuid())
  version Int     @default(1)
  order   Int
  prompt  String
  active  Boolean @default(true)
}

model TestSubmission {
  id           String     @id @default(cuid())
  vaId         String
  va           User       @relation(fields: [vaId], references: [id], onDelete: Cascade)
  testVersion  Int
  // [{questionId, promptSnapshot, answer}] — prompts snapshotted so grading
  // history stays readable after questions change.
  answers      Json
  status       TestStatus @default(pending_grading)
  adminComment String?
  submittedAt  DateTime   @default(now())
  gradedAt     DateTime?

  @@index([status])
}

// ---------- Notifications, settings, money tracking ----------

model Notification {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String
  title         String
  body          String?
  taskId        String?
  readAt        DateTime?
  emailedAt     DateTime?
  emailAttempts Int       @default(0)
  emailError    String?
  createdAt     DateTime  @default(now())

  @@index([userId, readAt])
  @@index([emailedAt, createdAt])
}

// Admin-editable settings (working hours, QC buffer, thresholds, pricing
// prompt, retention…) — changeable without redeploy.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Per-call record of AI spend. Doubles as the rate-limit counter (count rows
// in a window) and the abuse/spend audit trail.
model AiUsage {
  id              String   @id @default(cuid())
  userId          String
  turnCount       Int      @default(0)
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  cacheReadTokens Int      @default(0)
  model           String
  stopReason      String?
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
}

// Manual payment tracking history (no payment processing).
model PaymentEvent {
  id             String      @id @default(cuid())
  kind           PaymentKind
  counterpartyId String // VA userId or client userId
  taskId         String?
  amountCents    Int
  note           String?
  createdAt      DateTime    @default(now())

  @@index([counterpartyId])
}

// ---------- Money ----------
// The operator is the merchant of record: he sells the deliverable and the
// worker is a subcontractor paid out of collected revenue. Nothing is held on
// anyone's behalf. The word "escrow" must not appear in this codebase or the UI.

/**
 * What the client paid for a task. Not unique on taskId: a task can be paid,
 * refunded, and (as a new task) paid again, and a chargeback can arrive
 * months later.
 */
model Payment {
  id                String        @id @default(cuid())
  taskId            String
  task              Task          @relation(fields: [taskId], references: [id], onDelete: Restrict)
  amountCents       Int
  currency          String        @default("USD")
  method            PaymentMethod
  provider          String? // "stripe" | null for manual
  providerRef       String? // payment intent id / wire reference
  checkoutSessionId String?       @unique
  status            PaymentStatus @default(pending)
  receivedAt        DateTime?
  note              String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  refunds Refund[]

  @@unique([provider, providerRef])
  @@index([taskId])
  @@index([status])
}

model Refund {
  id          String   @id @default(cuid())
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  amountCents Int
  provider    String?
  providerRef String?
  reason      String?
  createdAt   DateTime @default(now())

  @@unique([provider, providerRef])
  @@index([paymentId])
}

/**
 * What a worker is owed / has been paid. Several rows per task are possible
 * (a reassignment after a worker was already partly settled).
 */
model Payout {
  id          String       @id @default(cuid())
  taskId      String
  task        Task         @relation(fields: [taskId], references: [id], onDelete: Restrict)
  vaId        String
  va          User         @relation(fields: [vaId], references: [id], onDelete: Restrict)
  amountCents Int
  currency    String       @default("USD")
  status      PayoutStatus @default(owed)
  releasedAt  DateTime?
  paidAt      DateTime?
  method      String?
  reference   String?
  note        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([taskId, vaId])
  @@index([vaId, status])
}

/**
 * Queued money instruction. Written inside the same transaction as the state
 * change; drained only by the scheduled endpoint. No server action ever calls
 * a payment provider directly, and idempotencyKey makes a retry safe.
 */
model MoneyIntent {
  id             String            @id @default(cuid())
  taskId         String
  task           Task              @relation(fields: [taskId], references: [id], onDelete: Restrict)
  kind           MoneyIntentKind
  amountCents    Int
  currency       String            @default("USD")
  idempotencyKey String            @unique
  status         MoneyIntentStatus @default(queued)
  attempts       Int               @default(0)
  lastError      String?
  processedAt    DateTime?
  createdAt      DateTime          @default(now())

  @@index([status, createdAt])
}

model Dispute {
  id                    String         @id @default(cuid())
  taskId                String
  task                  Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /**
   * Closed vocabulary anchored in TaskCategory.disputeCriteria — a free-text
   * "not satisfied" cannot open a dispute.
   */
  reasonCode            String
  /**
   * The client's own words. ADMIN ONLY — never selected in a worker-facing
   * query. This is the one place client identity could cross the divide.
   */
  reasonDetail          String
  /**
   * The only worker-visible description of the complaint. Drafted by the AI,
   * approved or edited by the admin. Must be non-null before the task can go
   * back to the worker.
   */
  adminSummaryForWorker String?
  outcome               DisputeOutcome @default(pending)
  decidedAt             DateTime?
  decidedById           String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([taskId])
  @@index([outcome])
}

// ---------- Public trust surfaces ----------

/**
 * Append-only. Enforced in Postgres (non-owner app role without UPDATE/DELETE
 * + BEFORE UPDATE/DELETE/TRUNCATE triggers); seq, occurredAt and the hash
 * chain are assigned by a BEFORE INSERT trigger so the app cannot forge them.
 * Category name/slug are snapshotted so a later rename cannot re-label
 * published history.
 */
model LedgerEntry {
  id              String     @id @default(cuid())
  seq             BigInt     @unique
  kind            LedgerKind
  amountCents     Int
  currency        String     @default("USD")
  categoryId      String?
  categorySlug    String?
  categoryName    String?
  /**
   * Origin of the money movement (Stripe event id, Payment id...) — a unique
   * pair so a redelivered webhook cannot double-count revenue.
   */
  sourceKind      String
  sourceId        String
  occurredAt      DateTime
  correctsEntryId String?
  isInternal      Boolean    @default(false)
  /**
   * Excluded from the published figures without being deleted.
   */
  publiclyVisible Boolean    @default(true)
  prevHash        String
  rowHash         String     @unique
  createdAt       DateTime   @default(now())

  @@unique([sourceKind, sourceId])
  @@unique([prevHash])
  @@index([occurredAt])
}

/**
 * Counters are periodic snapshots, never live queries: a number that moves on
 * every delivery lets either side subtract two page loads and read the other
 * side's price. Only advanced once enough new entries have accumulated.
 */
model MetricSnapshot {
  id             String   @id @default(cuid())
  key            String
  /**
   * Category id for per-category metrics, null for platform-wide.
   */
  dimension      String?
  unit           String // cents | count | minutes | ratio
  valueNumeric   Float
  windowStart    DateTime
  windowEnd      DateTime
  sampleSize     Int
  currency       String?
  /**
   * Hash of the query that produced it, so a definition change is visible.
   */
  definitionHash String
  createdAt      DateTime @default(now())

  @@unique([key, dimension, windowEnd])
  @@index([key, windowEnd])
}

/**
 * User- and settings-level audit. Separate from TaskEvent (which is task-
 * scoped and cascades); this must survive the deletion of what it describes.
 * Never stores raw price values — field names and redacted payloads only.
 */
model AdminEvent {
  id        String   @id @default(cuid())
  actorId   String
  entity    String
  entityId  String
  action    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
}

// ---------- Standing Capacity ----------
// The second client relationship mode, additive to the one-off task flow
// above: a client reserves a recurring weekly block of hours at a fixed
// price instead of pricing each task individually. Continuity lives here —
// on the account — never in a worker's head, so who's actually assigned can
// change without the client ever perceiving a handoff. RULE 2 (client_price
// / va_payout never mixed, never cross-visible) and the zero-contact rule
// apply exactly as they do everywhere else in this file, just at the weekly
// grain instead of the task grain.

/**
 * A client's standing weekly capacity block. One per client — a client is
 * either buying tasks one at a time or has reserved a block, not both at
 * once. tierHours/weeklyClientPriceCents/weeklyVaPayoutCents are a SNAPSHOT
 * taken at subscribe/renew time (see src/lib/settings.ts's
 * standingCapacityTiers), never a live lookup — a later change to the tier
 * price list must never silently reprice an account mid-period.
 */
model StandingCapacityAccount {
  id       String @id @default(cuid())
  clientId String @unique
  client   User   @relation("StandingCapacityAccountClient", fields: [clientId], references: [id], onDelete: Restrict)

  status StandingCapacityStatus @default(active)

  /// Same meaning as Task.isInternal: the operator's own practice account.
  /// Without it there was no correct value to pass when writing this
  /// account's sale and payout ledger entries, so both defaulted to
  /// isInternal=false and cleared BOTH gates of the public ledger filter —
  /// permanently, the table being append-only.
  isInternal Boolean @default(false)

  tierHours              Int
  weeklyClientPriceCents Int
  weeklyVaPayoutCents    Int
  currency               String @default("USD")

  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  minutesUsedThisPeriod Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments  StandingCapacityAssignment[]
  contextNotes AccountContextNote[]
  preference   AccountPreference?
  tasks        Task[]
  payments     StandingCapacityPayment[]
  payouts      StandingCapacityPayout[]

  @@index([status])
}

/**
 * Who is currently doing this account's work. Reassigning is: admin creates
 * a new row (activeTo: null); the prior current row's activeTo is closed in
 * the same transaction. A task submitted into the account routes directly
 * to whichever row has activeTo: null at submission time — it never touches
 * the public /va/pool. Multiple historical rows per account are expected and
 * kept, on purpose: it's the audit trail of who has ever had access to this
 * client's context.
 */
model StandingCapacityAssignment {
  id           String                  @id @default(cuid())
  accountId    String
  account      StandingCapacityAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  workerId     String
  worker       User                    @relation("StandingCapacityAssignmentWorker", fields: [workerId], references: [id], onDelete: Restrict)
  assignedById String
  activeFrom   DateTime                @default(now())
  /**
   * NULL = active. At most ONE row per account may be NULL, enforced by the
   * partial unique index StandingCapacityAssignment_one_active_per_account
   * (migration 20260802140000) — Prisma's DSL cannot express a WHERE on an
   * index, same as Dispute_one_pending_per_task. Do not assume the two
   * @@index lines below carry that guarantee: they are lookup indexes only,
   * and for a while they were the only thing here, which is exactly how two
   * concurrent assignWorker calls could both leave a row active.
   */
  activeTo     DateTime?

  @@index([accountId, activeTo])
  @@index([workerId, activeTo])
}

/**
 * The client's own words about their own working preferences —
 * communication style, delivery format. Written directly by the client, no
 * operator mediation: a client describing their own preferences cannot name
 * a worker by construction, the same trust level as a task description.
 */
model AccountPreference {
  id                 String                  @id @default(cuid())
  accountId          String                  @unique
  account            StandingCapacityAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  communicationStyle String?
  deliverableFormat  String?
  notes              String?
  updatedAt          DateTime                @updatedAt
}

/**
 * The running, identity-safe account history a newly-assigned worker reads
 * to pick up the account cold, instead of asking the client to repeat
 * itself. Append-only — a row is never edited or deleted — so nothing here
 * can silently erase what a prior worker or operator recorded.
 * A WORKER-authored row is always created with visible: false — a draft,
 * queued for an operator — until an ADMIN either publishes it as-is or
 * writes their own identity-safe rewrite and publishes that instead. This is
 * the exact mediation src/server/actions/admin-resolutions.ts's
 * publishRevisionInstructions already applies to a single task's revision
 * summary, extended here to a standing relationship instead of one task.
 * An ADMIN-authored row is visible immediately (the admin IS the operator
 * doing the identity-safety check as they write).
 */
model AccountContextNote {
  id            String                  @id @default(cuid())
  accountId     String
  account       StandingCapacityAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  authorId      String
  author        User                    @relation("AccountContextNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  authorRole    Role
  body          String
  visible       Boolean                 @default(false)
  publishedById String?
  publishedAt   DateTime?
  createdAt     DateTime                @default(now())

  @@index([accountId, visible, createdAt])
}

/**
 * A period's payment for reserved capacity, recorded the same admin-attested
 * way a one-off task's manual payment is (src/server/actions/
 * admin-payments.ts recordManualPayment). Real Stripe checkout for whole
 * blocks is future work, not built in this pass — Stripe itself has no live
 * keys configured anywhere in this app yet.
 */
model StandingCapacityPayment {
  id           String                  @id @default(cuid())
  accountId    String
  account      StandingCapacityAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  periodStart  DateTime
  periodEnd    DateTime
  amountCents  Int
  currency     String                  @default("USD")
  method       PaymentMethod           @default(wire)
  reference    String?
  recordedById String
  createdAt    DateTime                @default(now())

  /**
   * Mirrors StandingCapacityPayout's own per-period key. Without it, a period
   * recorded twice inserted a second `sale` into an append-only ledger, which
   * cannot be taken back. Migration 20260802160000 repairs any existing
   * duplicates before creating this.
   */
  @@unique([accountId, periodStart])
}

/**
 * The worker-side mirror of StandingCapacityPayment: one lump sum per
 * period to whoever actually did the work, instead of a Payout row per
 * task (see admin-qc.ts's isStandingCapacityTask guard — a task inside a
 * block is never priced or paid individually). Deliberately its own model
 * rather than reusing Payout, which requires a taskId.
 */
model StandingCapacityPayout {
  id           String                  @id @default(cuid())
  accountId    String
  account      StandingCapacityAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  vaId         String
  va           User                    @relation("StandingCapacityPayoutWorker", fields: [vaId], references: [id], onDelete: Restrict)
  periodStart  DateTime
  periodEnd    DateTime
  amountCents  Int
  currency     String                  @default("USD")
  method       String?
  reference    String?
  recordedById String
  createdAt    DateTime                @default(now())

  @@unique([accountId, vaId, periodStart])
  @@index([vaId])
}

enum AssistantMessageRole {
  user
  assistant
}

enum AssistantCategory {
  file_format
  dedup_technique
  deliverable_structure
  research_method
  writing_method
  other
}

/**
 * One row per turn (both the worker's message and the model's reply) in
 * the AfterDesk Assistant (src/lib/assistant-ai.ts). content is scrubbed
 * for price/PII patterns (src/lib/assistant-scrub.ts) BEFORE this row is
 * written — the admin pattern-clustering view (src/app/admin/assistant)
 * renders this column, so an unscrubbed row would be a new disclosure
 * surface. clusterKey is a cheap normalize-and-truncate of a user message
 * (lowercased, punctuation stripped, first ~8 words) used to group
 * similar questions without any ML — assistant replies never get a
 * clusterKey, only role: user rows do.
 */
model AssistantMessage {
  id               String               @id @default(cuid())
  vaId             String
  va               User                 @relation(fields: [vaId], references: [id], onDelete: Cascade)
  taskId           String
  role             AssistantMessageRole
  content          String
  category         AssistantCategory?
  clusterKey       String?
  inputTokens      Int                  @default(0)
  outputTokens     Int                  @default(0)
  cacheReadTokens  Int                  @default(0)
  requiresHumanReview Boolean           @default(false)
  createdAt        DateTime             @default(now())

  @@index([vaId, createdAt])
  @@index([taskId])
  @@index([clusterKey])
}

/**
 * One row per distinct clusterKey once an admin has looked at it — exists
 * only to track "resolved" state over time (did volume drop after the
 * Academy doc got fixed), separate from AssistantMessage itself so marking
 * a pattern resolved never touches the append-only conversation log.
 */
model AssistantPattern {
  clusterKey   String    @id
  category     AssistantCategory?
  resolvedAt   DateTime?
  resolvedById String?
  updatedAt    DateTime  @updatedAt
}

enum ClosedJobOutcome {
  won
  lost
}

enum LostReasonCategory {
  price_declined // client refused the quote — declined at the quote step
  deadline_at_risk // cancelled because the deadline could not be met
  worker_unavailable // worker went dark / never delivered
  client_cancelled_no_reason
  qc_failed_repeatedly // maxQcRounds exhausted, admin cancelled rather than reassign
  expired // quote or payment window lapsed with no client action
  other
}

/**
 * VISION (not built in this phase — see the founder's spec): the long-run
 * goal is that enough of these rows eventually let an AI make some pricing/QC
 * decisions autonomously, without a human approving every one. That is
 * explicitly NOT what this model does. This phase builds only the
 * foundation — a structured, permanent record of every closed job — plus an
 * on-demand ADVISORY analysis (src/lib/closed-job-analysis.ts) that
 * observes and suggests, never decides or acts. Any future autonomy work
 * is a separate, later decision, not an extension implied by this schema.
 *
 * One row per Task that reaches a final outcome (completed → won;
 * cancelled/declined/expired → lost). `completed` is not strictly terminal
 * (a revision or dispute can reopen it), so this is written with an upsert
 * keyed on taskId — a reopened-then-reclosed task updates its existing row
 * rather than erroring on the unique constraint.
 *
 * Deliberately minimal: everything already available via taskId (audit
 * history in TaskEvent, bot conversations in AssistantMessage, the
 * assigned worker's entry-exam record in ExamAttempt via task.claimedById)
 * is read through that existing foreign key, never copied here. The three
 * sources — this log, bot conversations, exam results — stay in separate
 * tables permanently; see the founder's spec for why merging them risks
 * conflating signals of different natures (a hard financial outcome, a
 * documentation-gap signal, and a starting-skill measurement).
 */
model ClosedJobLog {
  id     String           @id @default(cuid())
  taskId String           @unique
  task   Task             @relation(fields: [taskId], references: [id], onDelete: Restrict)
  outcome ClosedJobOutcome

  // Cached copy of clientPriceCents - vaPayoutCents, computed once at close
  // time — Task's own price fields remain the source of truth; this only
  // exists so aggregate analysis doesn't recompute across hundreds of rows.
  // Null when either price was never set (e.g. declined before pricing).
  marginCents Int?

  lostReasonCategory LostReasonCategory?
  lostReasonDetail   String?

  revisionRequestedBeforeClose Boolean @default(false)
  qcRoundsAtClose               Int     @default(0)
  finalRating                   Int?

  closedAt  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([outcome])
  @@index([lostReasonCategory])
}
