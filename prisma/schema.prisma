// AfterDesk — task marketplace V1
// Postgres. All timestamps UTC. All money in integer cents.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // Pooled connection for the running app.
  url        = env("DATABASE_URL")
  // Unpooled connection for migrations: the migration engine uses prepared
  // statements, which a transaction pooler (pgbouncer) breaks.
  directUrl  = env("DIRECT_URL")
  // Pricing-reference embeddings (TaskEmbedding, below). Confirmed working
  // on both managed Postgres and the local PGlite dev server (0.8.1) before
  // this was added — see the commit that introduced AI pricing suggestions.
  extensions = [vector]
}

// ---------- Enums ----------

enum Role {
  CLIENT
  VA
  ADMIN
}

// 15 states: the spec's original 12, plus awaiting_payment and disputed (both
// approved by the operator when the prepayment + dispute model was added), plus
// ai_processing (Phase 1B). Do not add states without telling the operator.
enum TaskStatus {
  submitted
  pricing_review
  quoted
  awaiting_payment // client accepted; task is NOT in the pool until paid
  declined
  /// Paid, and the machine block of the accepted plan is running. The task is
  /// NOT claimable here: `open` keeps meaning "a human may claim this". A task
  /// with no executable plan skips this state entirely and goes straight to
  /// `open`, exactly as before Phase 1B.
  ai_processing
  open
  claimed
  submitted_for_qc
  qc_rejected
  revision_requested
  completed
  disputed // client escalated within the post-delivery window
  cancelled
  expired
}

/**
 * How many closely-comparable APPROVED reference tasks backed the AI's
 * suggestion — set server-side from the retrieval result, never trusted
 * from the model's own self-report alone (see pricing-ai.ts: zero close
 * matches forces "low" regardless of what the model returns).
 */
enum AiConfidence {
  low
  medium
  high
}

enum TaskTier {
  standard
  high_value
}

enum VaStatus {
  pending_test
  pending_grading
  approved
  rejected
  suspended
}

enum FileKind {
  input
  deliverable
  /// PHASE 1B — produit par le moteur, jamais téléversé. La route d'upload
  /// HTTP ne peut pas en créer (elle exige un rôle CLIENT ou VA) ; seul
  /// createArtifactFile côté serveur le peut.
  artifact
}

/// PHASE 1B — qui a le droit de voir un artefact. Une relation au workflow ne
/// suffit pas : un fichier de travail interne et un candidat au livrable
/// vivent dans la même table et n'ont pas la même audience.
enum WorkflowArtifactVisibility {
  /// Sortie intermédiaire. L'admin seulement, jamais le worker ni le client.
  admin_only
  /// Joint au paquet humain : visible au worker UNE FOIS la tâche réclamée.
  worker_after_claim
  /// Le fichier candidat que le worker termine et livre. Visible au worker
  /// après réclamation, et jamais au client tel quel : il n'atteint le client
  /// qu'en devenant un livrable approuvé par le QC.
  deliverable_candidate
}

enum FileScanStatus {
  pending
  clean
  rejected
  error
}

enum QcStatus {
  pending
  approved
  rejected
  superseded
}

enum TestStatus {
  pending_grading
  approved
  rejected
}

enum PaymentKind {
  va_payout
  client_payment
}

enum PaymentMethod {
  card
  wire
  other
}

enum PaymentStatus {
  pending
  // Card is authorized (Stripe holds the amount) but not yet captured — no
  // money has actually moved, and no ledger "sale" entry exists yet. Set by
  // checkout.session.completed under capture_method: manual.
  authorized
  // Actually captured: money is in AfterDesk's account and a ledger "sale"
  // entry exists. Set only when the capture_client_payment money intent
  // succeeds (src/server/money-intents.ts), which fires on QC approval.
  received
  // An authorization that was voided before it was ever captured — a
  // cancelled task, or a dispute upheld before QC approval happened. Never
  // touched real money, so this is distinct from `refunded`.
  cancelled
  refunded
  partially_refunded
  chargeback
}

enum PayoutStatus {
  owed
  released
  paid
  void
  failed
}

enum DisputeOutcome {
  pending
  rejected // normal task variance — worker paid, client pays
  rework // worker error — sent back to fix
  upheld // worker error, unrecoverable — client refunded, worker unpaid
}

/**
 * Queued money instruction. Written inside the state transaction; drained by
 * the scheduled endpoint. Nothing calls Stripe or Wise from a server action.
 */
enum MoneyIntentKind {
  refund_client
  release_payout
  void_payout
  // Captures a held Stripe authorization for real — the client's card is
  // actually charged now. Enqueued by admin-qc.ts approveDeliverable, in
  // the same transaction that releases the worker's payout, so a capture
  // and a payout release always originate from the same "this delivery is
  // final" decision.
  capture_client_payment
  // Voids a Stripe authorization that was never captured (task cancelled,
  // or a dispute upheld, before QC approval ever triggered a capture).
  // Distinct from refund_client, which reverses money that actually moved.
  cancel_authorization
}

enum MoneyIntentStatus {
  queued
  processing
  done
  failed
}

enum LedgerKind {
  sale
  refund
  payout
  fee
  chargeback
  chargeback_reversal
  correction
}

enum StandingCapacityStatus {
  active
  paused
  cancelled
}

// ---------- Auth (Better Auth owns these shapes) ----------

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  // Locked server-side (input: false in Better Auth config) — never client-assignable.
  role          Role     @default(CLIENT)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions        Session[]
  accounts        Account[]
  vaProfile       VaProfile?
  clientTasks     Task[]           @relation("ClientTasks")
  claimedTasks    Task[]           @relation("ClaimedTasks")
  submissions     Submission[]
  testSubmissions TestSubmission[]
  notifications   Notification[]
  payouts         Payout[]
  examAttempts    ExamAttempt[]
  certifications  Certification[]

  // One standing capacity block per client — see StandingCapacityAccount.
  standingCapacityAccount     StandingCapacityAccount?     @relation("StandingCapacityAccountClient")
  standingCapacityAssignments StandingCapacityAssignment[] @relation("StandingCapacityAssignmentWorker")
  accountContextNotesAuthored AccountContextNote[]         @relation("AccountContextNoteAuthor")
  standingCapacityPayouts     StandingCapacityPayout[]     @relation("StandingCapacityPayoutWorker")
  assistantMessages           AssistantMessage[]
}

/**
 * One graded run at a course exam. Course content and the answer key live in
 * code (src/lib/academy) — the database records only who answered what and
 * the grade, so a content edit can never orphan an attempt.
 */
model ExamAttempt {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseSlug String
  /// Correct answers out of `total`, graded server-side against the key in code.
  score      Int
  total      Int
  passed     Boolean
  /// The chosen option index per question, in question order.
  answers    Json
  createdAt  DateTime @default(now())

  @@index([userId, courseSlug, createdAt])
}

/// Earned once per (worker, course) on the first passing attempt. Never revoked
/// by a retake — a certificate is a fact about a date, not a rolling state.
model Certification {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseSlug String
  earnedAt   DateTime @default(now())

  @@unique([userId, courseSlug])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

// Better Auth's database-backed rate limiter (survives restarts, shared
// across instances).
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

// ---------- VA ----------

model VaProfile {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                 VaStatus  @default(pending_test)
  timezone               String    @default("Asia/Manila")
  // 30-day retake cooldown anchor; admin can override.
  rejectedAt             DateTime?
  cooldownOverride       Boolean   @default(false)
  suspendedAt            DateTime?
  suspensionReason       String?
  // Application evidence reviewed by the operator before pool access. Kept
  // on the private profile only; none of these fields reach clients.
  experienceSummary      String?
  specialties            String?
  weeklyAvailability     String?
  portfolioUrl           String?
  applicationSubmittedAt DateTime?
  // Reliability record
  tasksCompleted         Int       @default(0)
  tasksAbandoned         Int       @default(0)
  deadlinesMissed        Int       @default(0)
  qcRejections           Int       @default(0)
  // Rolling score cache (last N ratings; N = settings.scoreWindow). Source of truth = Submission.rating.
  scoreCache             Float?
  ratedCount             Int       @default(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

// ---------- Tasks ----------

model Task {
  id          String     @id @default(cuid())
  clientId    String
  client      User       @relation("ClientTasks", fields: [clientId], references: [id], onDelete: Restrict)
  title       String
  description String
  quantity    String?
  tier        TaskTier   @default(standard)
  status      TaskStatus @default(submitted)

  // Set by the admin at pricing time. Required before a quote can be sent:
  // category drives the dispute criteria grid and the per-category medians,
  // estimatedMinutes bounds what a fair payout looks like.
  categoryId       String?
  category         TaskCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  estimatedMinutes Int?

  // Operator's own practice work. Frozen once the task leaves pricing_review
  // (enforced by trigger) so it can never become a retroactive delete button
  // on published numbers. Excluded from client-side public figures only —
  // a real payout to a real worker always counts.
  isInternal Boolean @default(false)

  // RULE 2 — two independent prices. Exposure is controlled exclusively
  // through the role-shaped selects in src/lib/queries/. clientPriceCents is
  // NEVER selected in any VA-facing query; vaPayoutCents NEVER in any
  // client-facing query.
  currency         String @default("USD")
  clientPriceCents Int?
  vaPayoutCents    Int?

  // AI pricing suggestion (internal — admin only, client and worker never
  // see any of this). Computed once, at submission (src/server/actions/
  // client-tasks.ts), so the pricing queue has something to sort
  // confidence on before the admin ever opens a task — never lazily on
  // page load. aiLowCents/aiHighCents/aiReasoning predate this feature and
  // are reused as-is (price_range_low / price_range_high / reasoning from
  // the model's structured output); everything below is new.
  aiLowCents  Int?
  aiHighCents Int?
  aiReasoning String?

  // RULE 2 applies here too: aiSuggestedPriceCents and
  // aiSuggestedVaPayoutCents are two independent model outputs, never one
  // derived from the other — same separation the human-entered
  // clientPriceCents/vaPayoutCents above already enforce.
  aiSuggestedPriceCents    Int?
  aiSuggestedVaPayoutCents Int?
  aiConfidence             AiConfidence?
  aiEstimatedMinutes       Int?
  // A hint only — the category select in the pricing form is still
  // required and still the admin's own call. Stored as a slug rather than
  // a relation: an unrecognized or stale slug should just fail to
  // highlight anything in the UI, never block pricing.
  aiSuggestedCategorySlug  String?
  // Null while the suggestion is still being computed (or was skipped —
  // ANTHROPIC_API_KEY/VOYAGE_API_KEY not configured) vs. genuinely absent;
  // the queue UI tells those two states apart on this alone.
  aiComputedAt             DateTime?

  // Deadlines: client-facing vs VA-facing (client minus QC buffer). Both stored. UTC.
  clientDeadlineUtc DateTime?
  vaDeadlineUtc     DateTime?

  quotedAt             DateTime?
  quoteExpiresAt       DateTime?
  acceptedAt           DateTime?
  claimedById          String?
  claimedBy            User?     @relation("ClaimedTasks", fields: [claimedById], references: [id], onDelete: Restrict)
  claimedAt            DateTime?
  completedAt          DateTime?
  revisionWindowEndsAt DateTime?
  // Escrow dispute window (settings.disputeWindowHours, default 48h), set at
  // QC approval alongside revisionWindowEndsAt but tracked independently: it
  // gates when the client's authorized payment gets captured and the
  // worker's payout gets released (releaseDisputeWindowFunds in sweeps.ts),
  // not when a revision can be requested. Paused/resumed by the same
  // windowPausedAt as revisionWindowEndsAt — a dispute suspends both.
  disputeWindowEndsAt  DateTime?
  declinedAt           DateTime?
  declineReason        String?
  cancelledAt          DateTime?
  cancelReason         String?
  expiredAt            DateTime?

  // Payment gate: quoted -> awaiting_payment -> open. Its own clock, distinct
  // from quoteExpiresAt (which measures how long the client has to decide).
  paymentDueAt DateTime?

  // Post-delivery window. revisionWindowEndsAt is the authoritative deadline;
  // a revision pauses it (windowPausedAt) and the paused duration is added
  // back on return, with a floor so reworked files always get a real look.
  // firstCompletedAt is immutable: audit anchor + hard ceiling on the loop.
  firstCompletedAt     DateTime?
  windowPausedAt       DateTime?
  revisionRounds       Int       @default(0)
  // Operator-authored, identity-safe instructions shown to the worker. The
  // client's raw revision/dispute text stays in TaskEvent/Dispute (admin only).
  revisionInstructions String?

  qcRounds      Int     @default(0)
  filesVerified Boolean @default(false)

  // Set only for a task submitted inside a Standing Capacity block (RULE 5 in
  // this feature's design notes). When set: clientPriceCents/vaPayoutCents
  // stay null (the price was already fixed at the block level, never per
  // task), the task skips pricing/quoting/payment entirely (submitted ->
  // claimed is a legal edge only for this case — see src/lib/state.ts), and
  // it is claimed directly by the account's current assignment, never
  // through the public pool.
  standingCapacityAccountId String?
  standingCapacityAccount   StandingCapacityAccount? @relation(fields: [standingCapacityAccountId], references: [id], onDelete: Restrict)

  /**
   * The execution-plan version the quote was built on, set by approvePricing
   * in the same transitionTask data write as the prices (the unchecked-input
   * mechanism state.ts documents for exactly this: setting an FK scalar
   * atomically with the status CAS). Null for tasks priced without the AI
   * work engine — a failed pipeline or a pre-engine task quotes exactly as
   * before, plan-less. RULE 3 note: the engine itself never writes this
   * column; only the admin's approval does.
   */
  quotedPlanVersionId String?
  quotedPlanVersion   TaskExecutionPlanVersion? @relation("QuotedPlanVersion", fields: [quotedPlanVersionId], references: [id], onDelete: SetNull)

  filesPurgedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  files        File[]
  submissions  Submission[]
  events       TaskEvent[]
  // Lists, not single rows: a task can be paid then refunded, and a
  // chargeback can arrive months later. At most one dispute may be OPEN at a
  // time — enforced by a partial unique index in the migration, not here.
  payments     Payment[]
  payouts      Payout[]
  disputes     Dispute[]
  moneyIntents MoneyIntent[]
  embeddingRow TaskEmbedding?
  closedJobLog ClosedJobLog?

  // AI work engine (Phase 1A) — suggestion-side data only, admin-facing.
  aiClassification   TaskAiClassification?
  planVersions       TaskExecutionPlanVersion[] @relation("TaskPlanVersions")
  acceptanceSnapshot TaskAcceptanceSnapshot?

  // Execution (Phase 1B) — admin-facing, plus the residual brief the worker
  // reads after claiming. Never projected into a client select.
  workflowRun      TaskWorkflowRun?
  humanWorkPackage TaskHumanWorkPackage?

  // Operational intelligence (Phase 1C) — admin-only, all of it, pinned out
  // of every client and worker select by price-wall.test.ts.
  operationalBaseline TaskOperationalBaseline?
  operationalActual   TaskOperationalActual?
  workSessions        TaskWorkSession[]
  qualityReviews      TaskQualityReview[]
  aiOperations        AiOperation[]

  @@index([status])
  @@index([clientId])
  @@index([claimedById])
  @@index([categoryId])
  @@index([standingCapacityAccountId])
}

/**
 * Closed, admin-editable taxonomy. A real table, not a Setting blob, because
 * ledger rows reference it permanently. Clients never self-select — the party
 * that benefits from a category must not choose it.
 */
model TaskCategory {
  id                       String   @id @default(cuid())
  slug                     String   @unique
  name                     String
  /**
   * What counts as delivered, and the tolerated error margin. Shown to the
   * client at quote time and to the worker before they claim, so a dispute is
   * checked against a written standard instead of judged by mood.
   */
  disputeCriteria          String?
  /**
   * Admin-set market reference rate (cents/hour) for the public MONEY SAVED
   * counter: (referenceHourlyRateCents/100 * hours) - clientPriceCents,
   * floored at 0 per task. Null means this category is simply excluded from
   * the counter rather than treated as a zero rate — an undefined comparison
   * must never silently read as "no savings." See src/lib/queries/public-stats.ts.
   */
  referenceHourlyRateCents Int?
  sortOrder                Int      @default(0)
  active                   Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  tasks Task[]
}

/**
 * One embedding per task, generated once from title+description when the AI
 * pricing suggestion first runs (src/lib/pricing-ai.ts) — whether or not
 * that task ever gets approved. A task becomes usable as a REFERENCE for
 * some later task's retrieval only once it has a real clientPriceCents /
 * vaPayoutCents (enforced in the retrieval query, not by anything here);
 * until then its embedding just sits here unused, which is fine — it means
 * the day it IS approved, no backfill is needed.
 * A separate table rather than a column on Task: the vector only matters to
 * one query (nearest-neighbor retrieval), and keeping it off the hot Task
 * table means every ordinary Task read stays exactly as cheap as before
 * this feature existed.
 * Unsupported("vector(1024)") because Prisma's schema language has no
 * native pgvector type; every read/write against this column goes through
 * $queryRaw/$executeRaw in src/lib/pricing-ai.ts. 1024 = the output
 * dimension of the Voyage embedding model pricing-ai.ts calls — the two
 * must be changed together or every existing row's dimension stops
 * matching new ones.
 */
model TaskEmbedding {
  taskId    String                      @id
  task      Task                        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  embedding Unsupported("vector(1024)")
  createdAt DateTime                    @default(now())
}

// One QC decision per submission attempt (a delivery may contain several files).
model Submission {
  id              String    @id @default(cuid())
  taskId          String
  task            Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  vaId            String
  va              User      @relation(fields: [vaId], references: [id], onDelete: Restrict)
  attemptNo       Int
  note            String?
  /**
   * Closed-schema delivery metrics, hardcoded per category in
   * src/lib/delivery-metrics.ts and validated by zod on write AND on read.
   * Integers and fixed enums only, never free text: unlike `note`, this is
   * shown to the paying client once the delivery has been approved, so the
   * RULE 1 argument that keeps `note` unprojected has to be structural here.
   * NULL means the category has no metrics schema, or the delivery predates
   * this column. An empty object would read as "zero records handled".
   */
  deliveryMetrics Json?
  qcStatus        QcStatus  @default(pending)
  qcComment       String?
  rating          Int? // 1-5, set at QC approval
  submittedAt     DateTime  @default(now())
  reviewedAt      DateTime?

  files File[]

  /// Phase 1C — un enregistrement STRUCTURÉ par passage de QC. Pas de
  /// @unique sur submissionId : le garde applicatif (updateMany sur
  /// qcStatus "pending") garantit déjà une décision unique aujourd'hui, et
  /// une seconde opinion ou un ré-examen sur litige sont des faits qu'on
  /// voudra journaliser sans migration destructive. reviewSequence suit le
  /// motif attemptNo ci-dessus.
  qualityReviews TaskQualityReview[]

  @@unique([taskId, attemptNo])
  @@index([qcStatus])
  @@index([vaId])
}

model File {
  id           String         @id @default(cuid())
  // Nullable until attached: upload happens first (ticket pattern), the
  // submit action claims the file by checking uploaderId and setting taskId.
  taskId       String?
  task         Task?          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submissionId String?
  submission   Submission?    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  kind         FileKind
  uploaderId   String
  storageKey   String         @unique
  fileName     String
  mime         String
  sizeBytes    Int
  // Uploads are unavailable until their declared type, byte signature and
  // malware scan all pass. `sha256` also makes incident response and
  // duplicate-malware blocking possible without retaining the raw upload.
  scanStatus   FileScanStatus @default(pending)
  detectedMime String?
  sha256       String?
  scanDetails  String?
  scannedAt    DateTime?
  createdAt    DateTime       @default(now())
  purgedAt     DateTime?

  /// PHASE 1B — rattachement RÉEL au workflow qui a produit le fichier, au
  /// lieu d'un tableau d'identifiants sans intégrité référentielle : un
  /// artefact ne peut pas pointer vers un run supprimé ni appartenir à un
  /// autre workflow. Null pour les fichiers client et les livrables worker.
  workflowRunId     String?
  workflowRun       TaskWorkflowRun?     @relation(fields: [workflowRunId], references: [id], onDelete: SetNull)
  workflowStepRunId String?
  workflowStepRun   TaskWorkflowStepRun? @relation(fields: [workflowStepRunId], references: [id], onDelete: SetNull)
  /// PHASE 1B — l'audience de l'artefact, explicite. Null pour tout ce qui
  /// n'est pas kind=artifact ; la route de téléchargement refuse un artefact
  /// dont la visibilité est nulle plutôt que de deviner.
  artifactVisibility WorkflowArtifactVisibility?

  accessLogs FileAccessLog[]

  @@index([taskId])
  @@index([uploaderId])
  @@index([scanStatus])
  @@index([workflowRunId])
}

model FileAccessLog {
  id        String   @id @default(cuid())
  fileId    String
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  userId    String
  action    String // "download" | "upload"
  createdAt DateTime @default(now())

  @@index([fileId])
}

// Audit log — one row per state change / notable admin action, written inside
// the same transaction as the change itself.
model TaskEvent {
  id         String      @id @default(cuid())
  taskId     String
  task       Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromStatus TaskStatus?
  toStatus   TaskStatus?
  action     String
  actorId    String?
  reason     String?
  meta       Json?
  createdAt  DateTime    @default(now())

  @@index([taskId])
}

// ---------- Entry test ----------

model TestQuestion {
  id      String  @id @default(cuid())
  version Int     @default(1)
  order   Int
  prompt  String
  active  Boolean @default(true)
}

model TestSubmission {
  id           String     @id @default(cuid())
  vaId         String
  va           User       @relation(fields: [vaId], references: [id], onDelete: Cascade)
  testVersion  Int
  // [{questionId, promptSnapshot, answer}] — prompts snapshotted so grading
  // history stays readable after questions change.
  answers      Json
  status       TestStatus @default(pending_grading)
  adminComment String?
  submittedAt  DateTime   @default(now())
  gradedAt     DateTime?

  @@index([status])
}

// ---------- Notifications, settings, money tracking ----------

model Notification {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String
  title         String
  body          String?
  taskId        String?
  readAt        DateTime?
  emailedAt     DateTime?
  emailAttempts Int       @default(0)
  emailError    String?
  createdAt     DateTime  @default(now())

  @@index([userId, readAt])
  @@index([emailedAt, createdAt])
}

// Admin-editable settings (working hours, QC buffer, thresholds, pricing
// prompt, retention…) — changeable without redeploy.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Per-call record of AI spend. Doubles as the rate-limit counter (count rows
// in a window) and the abuse/spend audit trail.
model AiUsage {
  id              String   @id @default(cuid())
  userId          String
  turnCount       Int      @default(0)
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  cacheReadTokens Int      @default(0)
  model           String
  stopReason      String?
  createdAt       DateTime @default(now())

  /// PHASE 1B — mesure des appels qui NE SONT PAS rattachés à une étape de
  /// workflow : intake, classification, planification, critique, assistant.
  /// Ces trois derniers arrivent avant qu'un plan accepté existe, donc ils ne
  /// peuvent pas porter de stepRunId et n'ont rien à faire dans
  /// TaskToolInvocation. Constat de l'audit : jusqu'ici le poste le plus cher
  /// du produit (Opus 5, thinking adaptatif, deux fois par tâche) ne mesurait
  /// rien du tout.
  ///
  /// Tous nullables ou avec défaut : les lignes d'intake déjà en base restent
  /// valides sans backfill, et `purpose` par défaut les décrit correctement
  /// puisque l'intake était le seul écrivain avant cette colonne.
  taskId           String?
  purpose          String  @default("intake")
  provider         String  @default("anthropic")
  cacheWriteTokens Int     @default(0)
  /// En MICRODOLLARS entiers (1 $ = 1 000 000). Un appel de classification
  /// coûte ~5 000 micros, soit un demi-cent : en cents entiers il serait
  /// arrondi à 0 ou à 1 et la somme serait fausse. Les cents n'apparaissent
  /// qu'à l'affichage.
  costMicros       Int     @default(0)

  /**
   * PHASE 1C — the durable-operation attachment. One AiUsage row per
   * PROVIDER CALL ACTUALLY EMITTED, append-only, NEVER deduplicated: if two
   * calls were really made and billed, two rows exist and both costs count.
   * A partial unique index on (operationId, attempt) — SQL-only, WHERE
   * operationId IS NOT NULL — makes an accidental same-attempt double write
   * a hard P2002, which is a BUG to surface, never a condition to swallow.
   * Intake rows predate operations and keep both fields null.
   */
  operationId String?
  operation   AiOperation? @relation(fields: [operationId], references: [id], onDelete: Restrict)
  attempt     Int?

  @@index([userId, createdAt])
  @@index([taskId])
  @@index([operationId])
}

// Manual payment tracking history (no payment processing).
model PaymentEvent {
  id             String      @id @default(cuid())
  kind           PaymentKind
  counterpartyId String // VA userId or client userId
  taskId         String?
  amountCents    Int
  note           String?
  createdAt      DateTime    @default(now())

  @@index([counterpartyId])
}

// ---------- Money ----------
// The operator is the merchant of record: he sells the deliverable and the
// worker is a subcontractor paid out of collected revenue. Nothing is held on
// anyone's behalf. The word "escrow" must not appear in this codebase or the UI.

/**
 * What the client paid for a task. Not unique on taskId: a task can be paid,
 * refunded, and (as a new task) paid again, and a chargeback can arrive
 * months later.
 */
model Payment {
  id                String        @id @default(cuid())
  taskId            String
  task              Task          @relation(fields: [taskId], references: [id], onDelete: Restrict)
  amountCents       Int
  currency          String        @default("USD")
  method            PaymentMethod
  provider          String? // "stripe" | null for manual
  providerRef       String? // payment intent id / wire reference
  checkoutSessionId String?       @unique
  status            PaymentStatus @default(pending)
  receivedAt        DateTime?
  /**
   * PHASE 1C — what Stripe actually captured, from `amount_received`. Until
   * now that value was returned by captureStripePayment and thrown away at
   * the call site. `amountCents` remains what was authorized; the ledger
   * remains the source of recognized revenue; this column exists for
   * reconciliation, and a mismatch with amountCents raises
   * CAPTURE_AMOUNT_MISMATCH on the operational actual. Null for manual
   * wires and for captures made before this column existed.
   */
  capturedAmountCents Int?
  note              String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  refunds Refund[]

  @@unique([provider, providerRef])
  @@index([taskId])
  @@index([status])
}

model Refund {
  id          String   @id @default(cuid())
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  amountCents Int
  provider    String?
  providerRef String?
  reason      String?
  createdAt   DateTime @default(now())

  @@unique([provider, providerRef])
  @@index([paymentId])
}

/**
 * What a worker is owed / has been paid. Several rows per task are possible
 * (a reassignment after a worker was already partly settled).
 */
model Payout {
  id          String       @id @default(cuid())
  taskId      String
  task        Task         @relation(fields: [taskId], references: [id], onDelete: Restrict)
  vaId        String
  va          User         @relation(fields: [vaId], references: [id], onDelete: Restrict)
  amountCents Int
  currency    String       @default("USD")
  status      PayoutStatus @default(owed)
  releasedAt  DateTime?
  paidAt      DateTime?
  method      String?
  reference   String?
  note        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([taskId, vaId])
  @@index([vaId, status])
}

/**
 * Queued money instruction. Written inside the same transaction as the state
 * change; drained only by the scheduled endpoint. No server action ever calls
 * a payment provider directly, and idempotencyKey makes a retry safe.
 */
model MoneyIntent {
  id             String            @id @default(cuid())
  taskId         String
  task           Task              @relation(fields: [taskId], references: [id], onDelete: Restrict)
  kind           MoneyIntentKind
  amountCents    Int
  currency       String            @default("USD")
  idempotencyKey String            @unique
  status         MoneyIntentStatus @default(queued)
  attempts       Int               @default(0)
  lastError      String?
  processedAt    DateTime?
  createdAt      DateTime          @default(now())

  /// BAIL. processMoneyIntents ne sélectionnait que les lignes `queued` ou
  /// `failed` : une ligne passée en `processing` par un runner qui plantait
  /// ensuite restait bloquée POUR TOUJOURS — invisible à toutes les
  /// exécutions suivantes, sans alerte et sans reprise possible.
  ///
  /// Le bail borne cette indisponibilité : une ligne `processing` dont le
  /// bail est expiré redevient réclamable. Le rejeu reste sûr côté
  /// fournisseur parce que chaque appel Stripe passe `idempotencyKey`, sur
  /// laquelle Stripe déduplique.
  leaseExpiresAt DateTime?
  lockedAt       DateTime?

  @@index([status, createdAt])
  @@index([leaseExpiresAt])
}

model Dispute {
  id                    String         @id @default(cuid())
  taskId                String
  task                  Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /**
   * Closed vocabulary anchored in TaskCategory.disputeCriteria — a free-text
   * "not satisfied" cannot open a dispute.
   */
  reasonCode            String
  /**
   * The client's own words. ADMIN ONLY — never selected in a worker-facing
   * query. This is the one place client identity could cross the divide.
   */
  reasonDetail          String
  /**
   * The only worker-visible description of the complaint. Drafted by the AI,
   * approved or edited by the admin. Must be non-null before the task can go
   * back to the worker.
   */
  adminSummaryForWorker String?
  outcome               DisputeOutcome @default(pending)
  decidedAt             DateTime?
  decidedById           String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([taskId])
  @@index([outcome])
}

// ---------- Public trust surfaces ----------

/**
 * Append-only. Enforced in Postgres (non-owner app role without UPDATE/DELETE
 * + BEFORE UPDATE/DELETE/TRUNCATE triggers); seq, occurredAt and the hash
 * chain are assigned by a BEFORE INSERT trigger so the app cannot forge them.
 * Category name/slug are snapshotted so a later rename cannot re-label
 * published history.
 */
model LedgerEntry {
  id              String     @id @default(cuid())
  seq             BigInt     @unique
  kind            LedgerKind
  amountCents     Int
  currency        String     @default("USD")
  categoryId      String?
  categorySlug    String?
  categoryName    String?
  /**
   * Origin of the money movement (Stripe event id, Payment id...) — a unique
   * pair so a redelivered webhook cannot double-count revenue.
   */
  sourceKind      String
  sourceId        String
  occurredAt      DateTime
  correctsEntryId String?
  isInternal      Boolean    @default(false)
  /**
   * Excluded from the published figures without being deleted.
   */
  publiclyVisible Boolean    @default(true)
  prevHash        String
  rowHash         String     @unique
  createdAt       DateTime   @default(now())

  @@unique([sourceKind, sourceId])
  @@unique([prevHash])
  @@index([occurredAt])
}

/**
 * Counters are periodic snapshots, never live queries: a number that moves on
 * every delivery lets either side subtract two page loads and read the other
 * side's price. Only advanced once enough new entries have accumulated.
 */
model MetricSnapshot {
  id             String   @id @default(cuid())
  key            String
  /**
   * Category id for per-category metrics, null for platform-wide.
   */
  dimension      String?
  unit           String // cents | count | minutes | ratio
  valueNumeric   Float
  windowStart    DateTime
  windowEnd      DateTime
  sampleSize     Int
  currency       String?
  /**
   * Hash of the query that produced it, so a definition change is visible.
   */
  definitionHash String
  createdAt      DateTime @default(now())

  @@unique([key, dimension, windowEnd])
  @@index([key, windowEnd])
}

/**
 * User- and settings-level audit. Separate from TaskEvent (which is task-
 * scoped and cascades); this must survive the deletion of what it describes.
 * Never stores raw price values — field names and redacted payloads only.
 */
model AdminEvent {
  id        String   @id @default(cuid())
  actorId   String
  entity    String
  entityId  String
  action    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
}

// ---------- Standing Capacity ----------
// The second client relationship mode, additive to the one-off task flow
// above: a client reserves a recurring weekly block of hours at a fixed
// price instead of pricing each task individually. Continuity lives here —
// on the account — never in a worker's head, so who's actually assigned can
// change without the client ever perceiving a handoff. RULE 2 (client_price
// / va_payout never mixed, never cross-visible) and the zero-contact rule
// apply exactly as they do everywhere else in this file, just at the weekly
// grain instead of the task grain.

/**
 * A client's standing weekly capacity block. One per client — a client is
 * either buying tasks one at a time or has reserved a block, not both at
 * once. tierHours/weeklyClientPriceCents/weeklyVaPayoutCents are a SNAPSHOT
 * taken at subscribe/renew time (see src/lib/settings.ts's
 * standingCapacityTiers), never a live lookup — a later change to the tier
 * price list must never silently reprice an account mid-period.
 */
model StandingCapacityAccount {
  id       String @id @default(cuid())
  clientId String @unique
  client   User   @relation("StandingCapacityAccountClient", fields: [clientId], references: [id], onDelete: Restrict)

  status StandingCapacityStatus @default(active)

  /// Same meaning as Task.isInternal: the operator's own practice account.
  /// Without it there was no correct value to pass when writing this
  /// account's sale and payout ledger entries, so both defaulted to
  /// isInternal=false and cleared BOTH gates of the public ledger filter —
  /// permanently, the table being append-only.
  isInternal Boolean @default(false)

  tierHours              Int
  weeklyClientPriceCents Int
  weeklyVaPayoutCents    Int
  currency               String @default("USD")

  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  minutesUsedThisPeriod Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments  StandingCapacityAssignment[]
  contextNotes AccountContextNote[]
  preference   AccountPreference?
  tasks        Task[]
  payments     StandingCapacityPayment[]
  payouts      StandingCapacityPayout[]

  @@index([status])
}

/**
 * Who is currently doing this account's work. Reassigning is: admin creates
 * a new row (activeTo: null); the prior current row's activeTo is closed in
 * the same transaction. A task submitted into the account routes directly
 * to whichever row has activeTo: null at submission time — it never touches
 * the public /va/pool. Multiple historical rows per account are expected and
 * kept, on purpose: it's the audit trail of who has ever had access to this
 * client's context.
 */
model StandingCapacityAssignment {
  id           String                  @id @default(cuid())
  accountId    String
  account      StandingCapacityAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  workerId     String
  worker       User                    @relation("StandingCapacityAssignmentWorker", fields: [workerId], references: [id], onDelete: Restrict)
  assignedById String
  activeFrom   DateTime                @default(now())
  /**
   * NULL = active. At most ONE row per account may be NULL, enforced by the
   * partial unique index StandingCapacityAssignment_one_active_per_account
   * (migration 20260802140000) — Prisma's DSL cannot express a WHERE on an
   * index, same as Dispute_one_pending_per_task. Do not assume the two
   * @@index lines below carry that guarantee: they are lookup indexes only,
   * and for a while they were the only thing here, which is exactly how two
   * concurrent assignWorker calls could both leave a row active.
   */
  activeTo     DateTime?

  @@index([accountId, activeTo])
  @@index([workerId, activeTo])
}

/**
 * The client's own words about their own working preferences —
 * communication style, delivery format. Written directly by the client, no
 * operator mediation: a client describing their own preferences cannot name
 * a worker by construction, the same trust level as a task description.
 */
model AccountPreference {
  id                 String                  @id @default(cuid())
  accountId          String                  @unique
  account            StandingCapacityAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  communicationStyle String?
  deliverableFormat  String?
  notes              String?
  updatedAt          DateTime                @updatedAt
}

/**
 * The running, identity-safe account history a newly-assigned worker reads
 * to pick up the account cold, instead of asking the client to repeat
 * itself. Append-only — a row is never edited or deleted — so nothing here
 * can silently erase what a prior worker or operator recorded.
 * A WORKER-authored row is always created with visible: false — a draft,
 * queued for an operator — until an ADMIN either publishes it as-is or
 * writes their own identity-safe rewrite and publishes that instead. This is
 * the exact mediation src/server/actions/admin-resolutions.ts's
 * publishRevisionInstructions already applies to a single task's revision
 * summary, extended here to a standing relationship instead of one task.
 * An ADMIN-authored row is visible immediately (the admin IS the operator
 * doing the identity-safety check as they write).
 */
model AccountContextNote {
  id            String                  @id @default(cuid())
  accountId     String
  account       StandingCapacityAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  authorId      String
  author        User                    @relation("AccountContextNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  authorRole    Role
  body          String
  visible       Boolean                 @default(false)
  publishedById String?
  publishedAt   DateTime?
  createdAt     DateTime                @default(now())

  @@index([accountId, visible, createdAt])
}

/**
 * A period's payment for reserved capacity, recorded the same admin-attested
 * way a one-off task's manual payment is (src/server/actions/
 * admin-payments.ts recordManualPayment). Real Stripe checkout for whole
 * blocks is future work, not built in this pass — Stripe itself has no live
 * keys configured anywhere in this app yet.
 */
model StandingCapacityPayment {
  id           String                  @id @default(cuid())
  accountId    String
  account      StandingCapacityAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  periodStart  DateTime
  periodEnd    DateTime
  amountCents  Int
  currency     String                  @default("USD")
  method       PaymentMethod           @default(wire)
  reference    String?
  recordedById String
  createdAt    DateTime                @default(now())

  /**
   * Mirrors StandingCapacityPayout's own per-period key. Without it, a period
   * recorded twice inserted a second `sale` into an append-only ledger, which
   * cannot be taken back. Migration 20260802160000 repairs any existing
   * duplicates before creating this.
   */
  @@unique([accountId, periodStart])
}

/**
 * The worker-side mirror of StandingCapacityPayment: one lump sum per
 * period to whoever actually did the work, instead of a Payout row per
 * task (see admin-qc.ts's isStandingCapacityTask guard — a task inside a
 * block is never priced or paid individually). Deliberately its own model
 * rather than reusing Payout, which requires a taskId.
 */
model StandingCapacityPayout {
  id           String                  @id @default(cuid())
  accountId    String
  account      StandingCapacityAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  vaId         String
  va           User                    @relation("StandingCapacityPayoutWorker", fields: [vaId], references: [id], onDelete: Restrict)
  periodStart  DateTime
  periodEnd    DateTime
  amountCents  Int
  currency     String                  @default("USD")
  method       String?
  reference    String?
  recordedById String
  createdAt    DateTime                @default(now())

  @@unique([accountId, vaId, periodStart])
  @@index([vaId])
}

enum AssistantMessageRole {
  user
  assistant
}

enum AssistantCategory {
  file_format
  dedup_technique
  deliverable_structure
  research_method
  writing_method
  other
}

/**
 * One row per turn (both the worker's message and the model's reply) in
 * the AfterDesk Assistant (src/lib/assistant-ai.ts). content is scrubbed
 * for price/PII patterns (src/lib/assistant-scrub.ts) BEFORE this row is
 * written — the admin pattern-clustering view (src/app/admin/assistant)
 * renders this column, so an unscrubbed row would be a new disclosure
 * surface. clusterKey is a cheap normalize-and-truncate of a user message
 * (lowercased, punctuation stripped, first ~8 words) used to group
 * similar questions without any ML — assistant replies never get a
 * clusterKey, only role: user rows do.
 */
model AssistantMessage {
  id                  String               @id @default(cuid())
  vaId                String
  va                  User                 @relation(fields: [vaId], references: [id], onDelete: Cascade)
  taskId              String
  role                AssistantMessageRole
  content             String
  category            AssistantCategory?
  clusterKey          String?
  inputTokens         Int                  @default(0)
  outputTokens        Int                  @default(0)
  cacheReadTokens     Int                  @default(0)
  requiresHumanReview Boolean              @default(false)
  createdAt           DateTime             @default(now())

  @@index([vaId, createdAt])
  @@index([taskId])
  @@index([clusterKey])
}

/**
 * One row per distinct clusterKey once an admin has looked at it — exists
 * only to track "resolved" state over time (did volume drop after the
 * Academy doc got fixed), separate from AssistantMessage itself so marking
 * a pattern resolved never touches the append-only conversation log.
 */
model AssistantPattern {
  clusterKey   String             @id
  category     AssistantCategory?
  resolvedAt   DateTime?
  resolvedById String?
  updatedAt    DateTime           @updatedAt
}

enum ClosedJobOutcome {
  won
  lost
}

enum LostReasonCategory {
  price_declined // client refused the quote — declined at the quote step
  deadline_at_risk // cancelled because the deadline could not be met
  worker_unavailable // worker went dark / never delivered
  client_cancelled_no_reason
  qc_failed_repeatedly // maxQcRounds exhausted, admin cancelled rather than reassign
  expired // quote or payment window lapsed with no client action
  other
}

/**
 * VISION (not built in this phase — see the founder's spec): the long-run
 * goal is that enough of these rows eventually let an AI make some pricing/QC
 * decisions autonomously, without a human approving every one. That is
 * explicitly NOT what this model does. This phase builds only the
 * foundation — a structured, permanent record of every closed job — plus an
 * on-demand ADVISORY analysis (src/lib/closed-job-analysis.ts) that
 * observes and suggests, never decides or acts. Any future autonomy work
 * is a separate, later decision, not an extension implied by this schema.
 * One row per Task that reaches a final outcome (completed → won;
 * cancelled/declined/expired → lost). `completed` is not strictly terminal
 * (a revision or dispute can reopen it), so this is written with an upsert
 * keyed on taskId — a reopened-then-reclosed task updates its existing row
 * rather than erroring on the unique constraint.
 * Deliberately minimal: everything already available via taskId (audit
 * history in TaskEvent, bot conversations in AssistantMessage, the
 * assigned worker's entry-exam record in ExamAttempt via task.claimedById)
 * is read through that existing foreign key, never copied here. The three
 * sources — this log, bot conversations, exam results — stay in separate
 * tables permanently; see the founder's spec for why merging them risks
 * conflating signals of different natures (a hard financial outcome, a
 * documentation-gap signal, and a starting-skill measurement).
 */
model ClosedJobLog {
  id      String           @id @default(cuid())
  taskId  String           @unique
  task    Task             @relation(fields: [taskId], references: [id], onDelete: Restrict)
  outcome ClosedJobOutcome

  // Cached copy of clientPriceCents - vaPayoutCents, computed once at close
  // time — Task's own price fields remain the source of truth; this only
  // exists so aggregate analysis doesn't recompute across hundreds of rows.
  // Null when either price was never set (e.g. declined before pricing).
  marginCents Int?

  lostReasonCategory LostReasonCategory?
  lostReasonDetail   String?

  revisionRequestedBeforeClose Boolean @default(false)
  qcRoundsAtClose              Int     @default(0)
  finalRating                  Int?

  closedAt  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([outcome])
  @@index([lostReasonCategory])
}

// ═══════════════════════════════════════════════════════════════════════════
// AI WORK ENGINE — Phase 1A (moteur de devis et de planification)
//
// Tout ce qui suit est du côté SUGGESTION du produit : visible par l'admin
// seulement, jamais projeté dans un select client ou travailleur (épinglé par
// test/price-wall.test.ts). RULE 3 vaut pour l'ensemble : aucun de ces
// enregistrements ne touche clientPriceCents/vaPayoutCents/quotedAt — seule
// approvePricing écrit ces trois-là, après un clic humain. La seule exception
// délibérée est TaskAcceptanceSnapshot, qui n'est pas une suggestion mais le
// CONTRAT : la copie immuable de ce que le client a vu et accepté.
// ═══════════════════════════════════════════════════════════════════════════

/// Niveau de vérification que le brief exige, estimé à la classification.
enum AiVerificationLevel {
  light
  standard
  rigorous
}

/// Voie de devis recommandée. `auto` est VOLONTAIREMENT ABSENT : le devis
/// automatique Niveau 1 est interdit en code tant qu'aucun workflow n'a une
/// erreur d'estimation mesurée sur de vraies exécutions (décision fondateur,
/// Phase 1A ajustement 5). L'ajouter plus tard est une migration additive
/// d'une ligne — l'omettre aujourd'hui est ce qui rend l'interdit structurel
/// plutôt que disciplinaire.
enum QuoteTier {
  assisted
  manual
}

enum PlanVersionSource {
  ai_generated
  admin_edited
}

enum PlanStepExecutor {
  ai
  human
  deterministic_code
}

/// Qui, côté humain, porte l'étape. Prévu AVANT que le rôle réviseur existe
/// (il n'y a que CLIENT/VA/ADMIN aujourd'hui) pour que sa création future ne
/// demande aucune migration du plan : une étape `reviewer` est simplement
/// exécutée par l'ADMIN tant que le rôle dédié n'est pas construit.
enum PlanStepHumanRole {
  worker
  specialist
  reviewer
  admin
}

enum PlanStepRiskLevel {
  low
  medium
  high
}

enum CritiqueSeverity {
  none
  minor
  major
  blocking
}

/// Honnêteté du chiffrage. `uncalibrated` = les constantes du catalogue de
/// coûts sont des points de départ jamais confrontés à une exécution réelle ;
/// c'est la SEULE valeur que la Phase 1A produit, codée en dur, et l'admin la
/// voit en bandeau. Les deux autres existent pour que le jour où la boucle
/// estimation/réalité tourne, le passage soit une donnée, pas une migration.
enum CostCalibration {
  uncalibrated
  partial
  calibrated
}

/// Étape 1 du pipeline : la lecture structurée du brief. Un enregistrement par
/// tâche, écrasé si le pipeline est relancé (upsert) — contrairement aux
/// versions de plan, la classification n'a pas d'historique à préserver : elle
/// ne porte aucune décision humaine.
model TaskAiClassification {
  id     String @id @default(cuid())
  taskId String @unique
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  /// Slug deviné, même contrat que Task.aiSuggestedCategorySlug : un slug
  /// inventé ou périmé ne surligne rien dans l'UI, ne bloque jamais.
  categorySlugGuess   String?
  objective           String
  deliverableFormat   String
  requiredFields      String[]
  quantityInterpreted Int?
  geography           String[]
  verificationLevel   AiVerificationLevel
  sourceRequirements  String[]
  sensitiveData       Boolean
  requiredAccess      String[]
  missingInformation  String[]
  assumptions         String[]
  quoteTier           QuoteTier
  /// Même plancher serveur que le pricing existant : zéro tâche de référence
  /// comparable force "low", peu importe l'auto-évaluation du modèle.
  confidence          AiConfidence
  model               String
  rawOutput           Json?
  computedAt          DateTime            @default(now())
}

/// Une version du plan d'exécution. APPEND-ONLY : une version n'est jamais
/// mutée après création — une édition admin insère la version N+1 avec
/// parentVersionId pointant sur ce qu'elle modifie, ce qui donne gratuitement
/// la piste d'audit « ce que l'IA a proposé / ce que l'admin a changé ».
/// L'immuabilité est tenue par la logique applicative et les tests (le trigger
/// SQL est réservé au snapshot d'acceptation, qui est un contrat).
///
/// Le résultat du CALCUL DÉTERMINISTE de coûts pour cette version est stocké
/// ici même (internalCost / suggested) : chaque version porte son chiffrage,
/// donc l'écart entre la proposition IA et la version éditée par l'admin est
/// une soustraction, pas une reconstruction.
model TaskExecutionPlanVersion {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation("TaskPlanVersions", fields: [taskId], references: [id], onDelete: Cascade)

  /// Monotone par tâche ; l'unicité est la vraie protection contre une
  /// course entre deux éditions simultanées.
  version Int
  source  PlanVersionSource

  parentVersionId String?
  parentVersion   TaskExecutionPlanVersion?  @relation("PlanVersionLineage", fields: [parentVersionId], references: [id], onDelete: SetNull)
  childVersions   TaskExecutionPlanVersion[] @relation("PlanVersionLineage")

  /// Précédent TaskEvent.actorId : une chaîne nue, pas une FK — l'audit
  /// n'impose pas de jointure et ne bloque jamais une suppression de compte.
  editedByAdminId String?
  editNote        String?

  deliverableDescription String
  assumptions            String[]
  exclusions             String[]

  // ── Chiffrage déterministe de CETTE version (audit) ──
  internalCostLikelyCents       Int
  internalCostConservativeCents Int
  suggestedPriceCents           Int
  suggestedVaPayoutCents        Int
  calibration                   CostCalibration

  /// PHASE 1D-α0 (correctif) — les agrégats économiques de l'automatisation,
  /// calculés par le preflight AVANT le devis et recopiés à l'identique sur
  /// TaskAcceptanceSnapshot à l'acceptation, dans la même transaction.
  ///
  /// Invariants imposés en code et testés :
  ///   expectedAutomationCostMicros     >= 0
  ///   conservativeAutomationCostMicros >= expectedAutomationCostMicros
  ///   automationSpendCeilingMicros     >= conservativeAutomationCostMicros
  ///
  /// Le plafond PEUT dépasser le coût attendu — c'est le risque que la
  /// politique économique accepte — mais il ne peut jamais être sous le
  /// scénario conservateur, qui est le minimum arithmétique pour que le plan
  /// soit exécutable une seule fois.
  expectedAutomationCostMicros     BigInt?
  conservativeAutomationCostMicros BigInt?
  automationSpendCeilingMicros     BigInt?
  automationCostPolicyVersion      String?

  /// Null pour une version admin_edited : aucun modèle n'a produit celle-là.
  model     String?
  rawOutput Json?
  createdAt DateTime @default(now())

  steps    TaskExecutionPlanStep[]
  critique TaskExecutionPlanCritique?

  quotedOnTasks Task[]                   @relation("QuotedPlanVersion")
  snapshots     TaskAcceptanceSnapshot[]
  workflowRuns  TaskWorkflowRun[]

  @@unique([taskId, version])
}

model TaskExecutionPlanStep {
  id            String                   @id @default(cuid())
  planVersionId String
  planVersion   TaskExecutionPlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)

  order       Int
  title       String
  description String
  executor    PlanStepExecutor
  /// Renseigné seulement quand executor = human.
  humanRole   PlanStepHumanRole?
  /// Vocabulaire libre résolu par le catalogue de coûts ; un outil inconnu
  /// coûte zéro et c'est précisément un des drapeaux de la critique.
  tool        String?

  /// PHASE 1B — la primitive exécutable à laquelle l'étape s'engage, et la
  /// version de cette primitive AU MOMENT OÙ LA VERSION DE PLAN A ÉTÉ ÉCRITE.
  /// Les deux sont figées ici : si le registre publie plus tard une v2, un
  /// plan déjà accepté reste épinglé à la v1 et le compilateur bascule
  /// l'étape en travail humain plutôt que de lui appliquer en silence un
  /// comportement que le client n'a jamais accepté. Le modèle choisit l'id,
  /// AVANT le devis ; le CODE estampille la version.
  primitiveId      String?
  primitiveVersion Int?

  /// PHASE 1B — l'effort humain décomposé. `fixedMinutes` ne dépend pas du
  /// volume (ouvrir les fichiers, lire le brief, relecture finale),
  /// `secondsPerUnit` est le coût par unité. Les trois estimations PERT
  /// ci-dessous chiffrent le plan COMPLET au devis et ne bougent pas : cette
  /// décomposition ne sert qu'à chiffrer le RÉSIDUEL une fois que la machine
  /// a résolu une partie des unités. En secondes parce que le travail par
  /// ligne descend couramment sous la minute, et en entier parce que la
  /// chaîne qui mène au payout ne doit contenir aucun flottant.
  fixedMinutes   Int?
  secondsPerUnit Int?

  estimatedMinutesOptimistic   Int
  estimatedMinutesLikely       Int
  estimatedMinutesConservative Int
  estimatedAiCostCents         Int @default(0)
  estimatedToolUnits           Int @default(0)

  /// PHASE 1D-α0 (correctif) — L'ÉCONOMIE DE CETTE ÉTAPE, GRAVÉE AU DEVIS.
  ///
  /// Une version de politique seule ne suffisait pas : une version est une
  /// PROVENANCE, pas une source de vérité. Si la politique change ou disparaît,
  /// un contrat qui ne stocke qu'un pointeur voit son économie bouger. Les
  /// valeurs elles-mêmes sont donc matérialisées ici, avant l'acceptation.
  ///
  /// À l'exécution, une tâche acceptée lit CES colonnes et n'ouvre jamais la
  /// table de politique. Supprimer entièrement une politique du code ne change
  /// donc ni le budget, ni la réservation, ni le comportement d'un contrat
  /// déjà signé.
  ///
  /// NULLABLES ET JAMAIS RÉTRO-REMPLIES : un contrat accepté avant ce
  /// correctif n'avait pas ces valeurs au moment de sa signature, et les
  /// reconstruire aujourd'hui inventerait une provenance. Une étape acceptée
  /// sans valeur gelée compile en HUMAIN, fail-closed.
  ///
  /// BigInt et non Int : le plafond Int de Prisma est de 2 147 483 647 micros,
  /// soit 2 147,48 $. Le type ne se choisit pas sur l'hypothèse que les
  /// primitives d'aujourd'hui coûtent quelques dollars — une primitive future
  /// ne doit pas exiger une migration de type pour la dépasser.
  expectedCostMicrosAtQuote      BigInt?
  maxCostMicrosPerAttemptAtQuote BigInt?
  /// Provenance seulement. Jamais relue pour décider d'un montant.
  automationCostPolicyVersion    String?
  /// Vrai quand le preflight économique a retiré l'automatisation de cette
  /// étape AVANT le devis, plutôt qu'après paiement.
  demotedForBudget               Boolean @default(false)

  verificationMethod String
  acceptanceCriteria String[]
  riskLevel          PlanStepRiskLevel
  riskNote           String?
  /// Ordres (champ `order`) des étapes préalables — des entiers plutôt que
  /// des FK pour rester trivialement copiable d'une version à la suivante.
  dependsOnOrder     Int[]

  /// Phase 1B — les exécutions de cette étape (une par run).
  stepRuns TaskWorkflowStepRun[]

  @@unique([planVersionId, order])
}

/// Étape critique, CONDITIONNELLE (jamais systématique — décision fondateur,
/// ajustement 1) : shouldCritique() dans src/lib/ai-work-engine/critique.ts
/// est la fonction pure qui décide, et elle est testée table par table.
/// Anthropic seulement en Phase 1A (ajustement 2) ; `provider` existe pour
/// qu'un second fournisseur soit une valeur de colonne, pas une migration.
model TaskExecutionPlanCritique {
  id            String                   @id @default(cuid())
  planVersionId String                   @unique
  planVersion   TaskExecutionPlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)

  provider          String           @default("anthropic")
  model             String
  missingSteps      String[]
  wrongToolFlags    String[]
  timeRiskFlags     String[]
  securityRiskFlags String[]
  overallAssessment String
  severity          CritiqueSeverity
  rawOutput         Json?
  computedAt        DateTime         @default(now())
}

/// LE CONTRAT. Créé dans la transaction même de acceptQuote : la copie figée
/// de tout ce que le client a vu au moment où il a cliqué Accepter — prix,
/// périmètre, quantité, livrable, hypothèses, exclusions, standard de litige,
/// et la politique de correction (les settings de fenêtres, figés, parce que
/// l'admin peut les changer ensuite et que le contrat du client ne doit pas
/// bouger avec eux).
///
/// IMMUABLE PAR TRIGGER Postgres (UPDATE et DELETE refusés), même mécanique
/// que le grand livre (second_shift_ledger_immutable). planVersionId nullable :
/// une tâche tarifée sans plan (échec du pipeline, tarification manuelle)
/// produit quand même un contrat complet — le contrat ne dépend pas du moteur.
model TaskAcceptanceSnapshot {
  id     String @id @default(cuid())
  taskId String @unique
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Restrict)

  planVersionId String?
  planVersion   TaskExecutionPlanVersion? @relation(fields: [planVersionId], references: [id], onDelete: Restrict)

  clientPriceCents  Int
  currency          String
  title             String
  description       String
  quantity          String?
  clientDeadlineUtc DateTime?

  deliverableDescription String?
  assumptions            String[]
  exclusions             String[]
  /// Le texte du standard au moment T — la catégorie peut être rééditée
  /// ensuite, le contrat non.
  disputeCriteria        String?

  // ── La politique de correction acceptée, figée ──
  revisionWindowHours Int
  maxRevisionRounds   Int
  disputeWindowHours  Int

  /// Précédent TaskEvent.actorId : chaîne nue, pas de FK.
  /// PHASE 1D-α0 (correctif) — LE CONTRAT PORTE SON PROPRE PLAFOND.
  ///
  /// Copie exacte des agrégats de la version de plan finale, écrite dans la
  /// MÊME transaction que l'acceptation. Le compilateur lit le plafond ici et
  /// ne le recalcule jamais depuis le registre courant : c'était le défaut
  /// exact que ce correctif supprime, où un déploiement postérieur relevait
  /// rétroactivement le budget de mandats déjà vendus.
  expectedAutomationCostMicros     BigInt?
  conservativeAutomationCostMicros BigInt?
  automationSpendCeilingMicros     BigInt?
  automationCostPolicyVersion      String?

  acceptedByUserId String
  createdAt        DateTime @default(now())

  /// Phase 1B — l'exécution de ce contrat, s'il y en a une.
  workflowRun TaskWorkflowRun?

  /// Phase 1C — les estimations internes figées au même instant que le
  /// contrat, dans leur propre table : les coûts et marges n'ont rien à
  /// faire dans un enregistrement dont le rôle est « ce que le client a vu ».
  operationalBaseline TaskOperationalBaseline?
}

// ---------- Phase 1B : exécution du plan accepté ----------

enum TaskWorkflowRunStatus {
  /// Compilation en cours (état transitoire, écrit puis remplacé dans la
  /// même transaction — visible seulement si le processus meurt pendant).
  compiling
  /// Des étapes machine restent à exécuter.
  running
  /// Le bloc machine est terminé, le paquet humain est publié.
  awaiting_human
  /// Arrêté et en attente d'une décision admin (budget dépassé, étape
  /// épuisée). Ne reprend jamais tout seul.
  paused
  /// Abandonné : la tâche est repartie en travail humain intégral.
  abandoned
  done
}

enum TaskWorkflowStepStatus {
  /// Ses dépendances ne sont pas encore satisfaites.
  pending
  /// Exécutable maintenant.
  ready
  /// Réclamée par un runner qui détient un bail.
  running
  done
  /// A échoué et sera reprise après `nextAttemptAt`, jusqu'à MAX_ATTEMPTS.
  failed
  /// Le compilateur l'a classée humaine : elle rejoint le paquet résiduel.
  handed_to_human
}

enum WorkflowExecutionMode {
  automated
  human
}

/// UNE EXÉCUTION PAR CONTRAT ACCEPTÉ.
///
/// L'unicité porte sur `snapshotId`, pas sur `taskId` : ce qui s'exécute est
/// un contrat, pas une tâche. Les deux ont la même cardinalité aujourd'hui
/// (TaskAcceptanceSnapshot.taskId est déjà @unique) mais l'énoncé juste est
/// celui-là, et la FK vers le contrat devient explicite.
model TaskWorkflowRun {
  id String @id @default(cuid())

  /// Le contrat exécuté. Restrict : un snapshot ne disparaît pas sous un run.
  snapshotId String                 @unique
  snapshot   TaskAcceptanceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)

  /// @unique aussi, et les deux contraintes sont voulues. `snapshotId` porte
  /// la vérité sémantique (un run exécute un CONTRAT) ; `taskId` porte la
  /// garantie opérationnelle (jamais deux runs sur une tâche). Elles sont
  /// équivalentes aujourd'hui puisque TaskAcceptanceSnapshot.taskId est
  /// @unique — et si elles cessaient de l'être, la base refuserait au lieu de
  /// laisser passer.
  taskId String @unique
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  /// Copié depuis le snapshot à la compilation. Redondant avec
  /// snapshot.planVersionId et c'est voulu : le run affirme lui-même quelle
  /// version il exécute, donc une lecture du run seul suffit à l'audit.
  planVersionId String
  planVersion   TaskExecutionPlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Restrict)

  status TaskWorkflowRunStatus @default(compiling)

  /// Compte des étapes après compilation — la répartition machine/humain
  /// calculée en CODE, jamais annoncée par un modèle.
  automatedStepCount Int @default(0)
  humanStepCount     Int @default(0)

  /// Unités (lignes, enregistrements) du mandat. `unitsTotal` vient de la
  /// classification ; `unitsResolvedAutomatically` est rempli par
  /// split.exceptions. Les deux alimentent le calcul du résiduel.
  unitsTotal                 Int?
  unitsResolvedAutomatically Int?

  /// PHASE 1C — drafted vs verified, persisted as COLUMNS. Until now the
  /// distinction lived only as prose inside the human package copy (the
  /// "0 of 12 already filled in" incident), which made it unqueryable.
  /// `unitsPrefilled` = rows the machine drafted at all;
  /// `unitsVerifiedByMachine` = rows that cleared the two-source bar.
  unitsPrefilled         Int?
  unitsVerifiedByMachine Int?

  /// Coûts RÉELS, en microdollars entiers (1 $ = 1 000 000).
  actualAiCostMicros   Int @default(0)
  actualToolCostMicros Int @default(0)

  /// PHASE 1D-α0 — LE PLAFOND D'AUTOMATISATION, ET SA PROVENANCE.
  ///
  /// Gelé À LA COMPILATION, dans la transaction qui crée ce run, jamais
  /// recalculé ensuite. Sa source est la somme des `estimatedAiCostCents` des
  /// étapes du plan ACCEPTÉ (TaskExecutionPlanStep), c'est-à-dire la même
  /// grandeur que `computeInternalCostCents` a déjà fait entrer dans le prix
  /// que le client a signé.
  ///
  /// Ce n'est PAS une fraction du prix client. Dériver un plafond de dépense
  /// d'un prix reviendrait à autoriser plus de dépense sur un mandat cher que
  /// sur un mandat identique moins cher, alors que c'est le TRAVAIL qui décide
  /// de ce que la machine peut coûter.
  ///
  /// `null` = aucune étape machine, donc aucune dépense autorisée. Un plafond
  /// absent n'a jamais voulu dire « illimité » ici, contrairement au
  /// `costCeilingMicros: 0` de 1B qui portait exactement ce sens et n'était lu
  /// par personne.
  /// PHASE 1D-α0 (correctif) — COPIÉ DEPUIS LE SNAPSHOT, JAMAIS RECALCULÉ.
  ///
  /// La version précédente dérivait ce plafond à la compilation, qui tourne
  /// APRÈS le paiement, en lisant les plafonds du registre courant : un
  /// déploiement relevait donc rétroactivement le budget de mandats déjà
  /// vendus. Il est maintenant recopié tel quel depuis
  /// TaskAcceptanceSnapshot.automationSpendCeilingMicros.
  ///
  /// BigInt : le plafond Int de Prisma (2 147,48 $) est exactement le
  /// débordement identifié en Phase 1C.
  runAutomationBudgetMicros BigInt?
  /// Provenance de la politique en vigueur au devis. Jamais relue pour
  /// décider d'un montant.
  budgetPolicyVersion       String?

  /// Renseigné quand status = paused : ce que l'admin doit trancher.
  pausedReason String?

  compiledAt DateTime?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  steps         TaskWorkflowStepRun[]
  humanPackage  TaskHumanWorkPackage?
  artifacts     File[]
  budgetHolds   WorkflowBudgetHold[]

  @@index([status])
  @@index([taskId])
}

/// UNE LIGNE PAR ÉTAPE COMPILÉE, machine ou humaine.
model TaskWorkflowStepRun {
  id    String          @id @default(cuid())
  runId String
  run   TaskWorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  /// L'étape du plan accepté dont celle-ci est l'exécution. Restrict : le
  /// plan est le contrat, il ne s'efface pas sous son exécution.
  planStepId String
  planStep   TaskExecutionPlanStep @relation(fields: [planStepId], references: [id], onDelete: Restrict)

  order Int

  /// Recopiés depuis l'étape de plan au moment de la compilation, pour que la
  /// lecture d'un run n'ait jamais à re-résoudre le contrat.
  primitiveId      String?
  primitiveVersion Int?
  executionMode    WorkflowExecutionMode
  status           TaskWorkflowStepStatus @default(pending)

  /// Pourquoi cette étape est humaine (`human_step`, `no_primitive`,
  /// `unknown_primitive`, `primitive_version_changed`, `depends_on_human`).
  /// Null pour une étape automatisée. C'est ce que la console admin affiche.
  handoffReason String?

  /// BAIL ET REPRISE. `status = running` seul ne suffit pas : un runner qui
  /// meurt après avoir réclamé laisserait l'étape bloquée pour toujours —
  /// exactement le défaut corrigé sur MoneyIntent. Une étape `running` dont
  /// le bail est expiré est réclamable par un autre runner.
  attempts       Int       @default(0)
  lockedAt       DateTime?
  /// Identifiant de l'invocation détentrice. Diagnostic seulement : c'est le
  /// bail, pas ce champ, qui décide qui peut réclamer.
  lockedBy       String?
  leaseExpiresAt DateTime?
  /// Backoff déterministe : l'étape n'est pas re-sélectionnée avant cette
  /// date. Sans ce champ, un échec transitoire est réessayé en boucle serrée
  /// à chaque tick de cron.
  nextAttemptAt  DateTime?
  lastError      String?

  /// Résumés bornés, pour la console admin. Jamais la sortie complète : les
  /// données vivent dans les artefacts.
  inputSummary  Json?
  outputSummary Json?

  /// Coût réel de cette étape, en microdollars entiers.
  actualCostMicros Int @default(0)

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  invocations TaskToolInvocation[]
  artifacts   File[]

  @@unique([runId, order])
  @@index([status, nextAttemptAt])
  @@index([leaseExpiresAt])
}

/// UNE LIGNE PAR TENTATIVE D'INVOCATION. Append-only : une tentative ratée
/// reste inscrite, parce que c'est elle qui a coûté de l'argent.
///
/// Trois identifiants distincts, à ne pas confondre :
///   - `operationKey` : la clé LOGIQUE STABLE de l'opération. Identique d'une
///     tentative à l'autre. C'est elle qui dit « c'est le même travail ».
///   - `attempt` : le numéro de tentative. C'est lui qui rend deux lignes
///     distinctes pour la même opération.
///   - `providerIdempotencyKey` : la clé transmise au fournisseur externe,
///     QUAND il en accepte une. Nullable, parce que tous n'en acceptent pas.
///
/// Ce que cette table NE prétend PAS garantir : qu'un fournisseur externe ne
/// facturera jamais deux fois. Si un appel aboutit chez le fournisseur puis
/// que le processus meurt avant l'écriture, la reprise rappellera. Sans clé
/// d'idempotence côté fournisseur, cet appel est facturé deux fois et la
/// seule chose que nous puissions faire honnêtement est de l'avoir écrit.
model TaskToolInvocation {
  id        String              @id @default(cuid())
  stepRunId String
  stepRun   TaskWorkflowStepRun @relation(fields: [stepRunId], references: [id], onDelete: Cascade)

  primitiveId String
  operationKey String
  attempt      Int
  providerIdempotencyKey String?

  provider String
  model    String?

  inputTokens      Int @default(0)
  outputTokens     Int @default(0)
  cacheReadTokens  Int @default(0)
  cacheWriteTokens Int @default(0)
  /// Recherches web facturées à l'unité par le fournisseur.
  searchCount      Int @default(0)
  /// En microdollars entiers, calculé en code depuis une table de tarifs —
  /// jamais un chiffre annoncé par un modèle.
  costMicros       Int @default(0)

  durationMs Int     @default(0)
  ok         Boolean
  error      String?
  createdAt  DateTime @default(now())

  /// PHASE 1D-α0 — la classification d'échec, pour que la politique de rejeu
  /// dépende de la cause. Avant, un `catch` unique rejouait un 401 permanent
  /// exactement comme un 429 transitoire.
  errorClass ProviderErrorClass?
  httpStatus Int?

  /// PHASE 1D-α0 — L'ÉTAT DE DÉPENSE, ET POURQUOI IL NE SE DÉDUIT PAS DE `ok`.
  ///
  /// Un AbortSignal prouve que NOUS avons cessé d'attendre. Il ne prouve pas
  /// que le fournisseur n'a rien facturé : la requête peut avoir été émise,
  /// traitée et facturée pendant que nous raccrochions. Écrire un coût de zéro
  /// dans ce cas serait fabriquer un zéro, exactement ce que la loi
  /// d'affichage de 1C interdit partout ailleurs.
  ///
  /// L'incertitude est donc un état, pas une absence.
  dispatchState InvocationDispatchState @default(settled)

  /// Bornes réelles de l'appel. `durationMs` ne dit pas QUAND, et des
  /// percentiles de latence en ont besoin.
  startedAt  DateTime?
  finishedAt DateTime?

  @@unique([stepRunId, operationKey, attempt])
  @@index([stepRunId])
  /// Requêté par le rapport de dépense incertaine.
  @@index([dispatchState])
}

/// PHASE 1D-α0 — taxonomie d'échec fournisseur (src/lib/ai-work-engine/
/// provider-error.ts). Les classes permanentes ne sont JAMAIS rejouées comme
/// des transitoires.
enum ProviderErrorClass {
  auth
  quota
  rate_limit
  timeout
  bad_request
  provider_5xx
  unknown
}

/// PHASE 1D-α0 — ce que l'on sait réellement de la dépense d'une tentative.
///
/// `settled` : réponse reçue, usage lu, coût mesuré.
/// `cancelled_before_dispatch` : rien n'a été émis, coût nul et certain.
/// `dispatched_then_cancelled` : émis puis abandonné, usage INCONNU.
/// `unaccounted` : échec sans réponse exploitable, usage INCONNU.
///
/// Les deux derniers gardent leur réservation budgétaire active : tant qu'on
/// ne sait pas, on suppose que c'est facturé. Sous-estimer une dépense est
/// précisément le défaut qui la laisse dériver.
enum InvocationDispatchState {
  settled
  cancelled_before_dispatch
  dispatched_then_cancelled
  unaccounted
}

/// PHASE 1D-α0 — LA RÉSERVATION BUDGÉTAIRE.
///
/// Pourquoi une table plutôt qu'une comparaison. Le contrôle évident
/// (`dépensé + estimation <= plafond`) est faux dès que deux tentatives se
/// chevauchent, et elles le peuvent : un bail expiré est repris par un second
/// passage pendant que le premier appel est encore en vol. Les deux lisent la
/// même dépense, les deux concluent qu'il reste de la place, les deux
/// dépensent.
///
/// Une réservation rend la place PRISE avant l'appel. Le pire cas de la
/// tentative est retenu sous verrou consultatif, puis converti en dépense
/// réelle (`settled`) ou relâché (`released`) si rien n'a été émis. Un hold
/// dont l'issue est inconnue n'est jamais relâché.
model WorkflowBudgetHold {
  id String @id @default(cuid())

  runId String
  run   TaskWorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  stepRunId    String
  attempt      Int
  /// Clé logique de l'opération, pour rattacher le hold à son invocation.
  operationKey String

  /// Le PIRE cas de cette tentative, en microdollars. Jamais une moyenne :
  /// une réservation optimiste ne réserve rien. BigInt comme tout montant en
  /// micros : une primitive future ne doit pas exiger une migration de type
  /// pour dépasser le plafond Int de 2 147,48 $.
  amountMicros BigInt

  status WorkflowBudgetHoldStatus @default(held)

  /// La dépense réellement constatée à la conversion. Null tant que `held`.
  settledMicros BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Une tentative réserve une fois. Un rejeu de la même tentative retombe
  /// sur le même hold au lieu d'en créer un second.
  @@unique([stepRunId, attempt, operationKey])
  @@index([runId, status])
}

enum WorkflowBudgetHoldStatus {
  held
  settled
  released
}

/// LE MANDAT RÉSIDUEL REMIS À UN HUMAIN.
///
/// Ce n'est PAS une tâche enfant et ce n'est pas réclamable en soi : la tâche
/// reste une, le bassin la voit une fois, le QC la voit une fois, le payout
/// est unique. Cette table ne fait que remplacer le brief générique par un
/// brief réduit quand il en existe un.
///
/// IMMUABLE DÈS LA RÉCLAMATION : un trigger Postgres refuse tout UPDATE dès
/// que la tâche porte un `claimedById`. Un travailleur ne peut pas voir son
/// mandat, son payout ou sa liste d'unités changer sous lui après avoir
/// accepté le travail.
model TaskHumanWorkPackage {
  id    String          @id @default(cuid())
  runId String          @unique
  run   TaskWorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  /// @unique : un run est déjà unique par tâche, donc un paquet l'est aussi.
  /// La contrainte est portée par la base plutôt que déduite, pour qu'aucun
  /// chemin ne puisse publier deux mandats résiduels sur la même tâche.
  taskId String @unique
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  /// La version de plan dont ce paquet dérive — le contrat, encore.
  planVersionId String

  /// Texte remis au travailleur. Assaini par le même sanitiseur que le
  /// périmètre client : pas de tiret cadratin, longueur bornée.
  objective         String
  whatIsAlreadyDone String
  instructions      String
  checklist         String[]

  /// Le compte qui justifie le payout.
  unitsRemaining Int
  unitsTotal     Int

  /// Minutes calculées par residual.ts : fixe + (par-unité × restantes).
  estimatedMinutes Int
  /// Le payout du résiduel, déterministe, écrit avant l'entrée au bassin.
  computedPayoutCents Int
  /// Le vaPayoutCents approuvé au devis — le budget de référence, conservé
  /// pour que l'écart reste auditable après coup.
  reservedBudgetCents Int

  createdAt DateTime @default(now())

  @@index([taskId])
}

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 1C — OPERATIONAL INTELLIGENCE
//
// Every model below is ADMIN-ONLY data. None of it is ever projected into a
// client or worker select; price-wall.test.ts pins the relation names out of
// every role-shaped query. The three-axis rule that governs the whole layer:
// the EXECUTION key describes what is done (fragmenting on primitive change
// is correct), the PRICING and QUALITY policy versions describe how it was
// priced and graded (changing them must never fragment operational history —
// they stratify, as columns).
// ═══════════════════════════════════════════════════════════════════════════

/// Same lease/CAS vocabulary as MoneyIntent and TaskWorkflowStepRun — the
/// third copy of the motif, kept deliberately identical.
enum AiOperationStatus {
  reserved
  running
  succeeded
  failed
  abandoned
}

enum WorkSessionRole {
  worker
  reviewer
  admin_operator
}

enum WorkSessionPhase {
  residual_work
  qc
  revision
  manual_fallback
}

enum WorkSessionStatus {
  active
  paused
  completed
  abandoned
}

enum WorkSessionSource {
  timer
  manual_correction
  system_recovery
}

enum QualityReviewOutcome {
  approved
  revision_required
  rejected
}

/// Phase 1C calibration levels — four values, deliberately NOT the Phase-1A
/// CostCalibration enum (three values): 1C-β bridges pricing onto this one.
enum CalibrationLevel {
  uncalibrated
  early_signal
  partially_calibrated
  calibrated
}

/// Failure provenance, derived in code (outcome-class.ts) with a fixed
/// precedence. Commercial success rates count all eight classes; technical
/// reliability excludes the three purely external interruptions
/// (client_cancelled, admin_cancelled, payment_failure).
enum TaskOutcomeClass {
  disputed
  payment_failure
  client_cancelled
  admin_cancelled
  worker_failure
  provider_failure
  workflow_failure
  workflow_success
}

enum CalibrationStratumDimension {
  pricing
  quality
}

/**
 * THE DURABLE RESERVATION for one logical AI operation of the quote
 * pipeline (classification, plan, critique). Created BEFORE the provider
 * call, claimed by CAS with a lease, closed FENCED on lockedBy (the
 * Phase-1B runner lesson: a zombie whose lease expired must never mark the
 * operation succeeded over its successor). operationKey is deterministic
 * from what exists before any result does — engine:{taskId}:{runKey}:{stage},
 * never a count+1.
 */
model AiOperation {
  id     String  @id @default(cuid())
  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  /// classification | planning | critique (intake/assistant have no ops yet)
  purpose      String
  operationKey String            @unique
  status       AiOperationStatus @default(reserved)

  attempts       Int       @default(0)
  lockedAt       DateTime?
  /// The fencing token. Every terminal write carries it in the WHERE.
  lockedBy       String?
  leaseExpiresAt DateTime?
  nextAttemptAt  DateTime?
  lastError      String?

  /// Attached AFTER the business row exists: ("planVersion", cuid). The
  /// result points back to the operation, never the other way around.
  resultKind String?
  resultId   String?

  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  usages AiUsage[]

  @@index([taskId])
  @@index([status, nextAttemptAt])
}

/**
 * THE INTERNAL BASELINE — the estimates exactly as they existed at
 * acceptance, before execution rewrites anything (workflow-runs.ts
 * overwrites Task.estimatedMinutes and vaPayoutCents at handover, so this
 * row is the only durable record of the quoted pair). Created in the SAME
 * transaction as TaskAcceptanceSnapshot; immutable by its own Postgres
 * trigger (a NEW function — no existing trigger is CREATE OR REPLACEd).
 *
 * Three provenances, never blended:
 *  - planned*        — derived from the accepted plan's own steps;
 *  - estimated*      — the quote as it was actually computed;
 *  - modeled*AtQuote — catalog constants that entered the price without
 *                      being in the plan. The flat 20 reviewer minutes of
 *                      pricing.ts is NOT a plan fact, and naming it as one
 *                      would make "the plan was wrong" and "the policy
 *                      ignores the plan" indistinguishable forever.
 */
model TaskOperationalBaseline {
  id         String                 @id @default(cuid())
  taskId     String                 @unique
  task       Task                   @relation(fields: [taskId], references: [id], onDelete: Restrict)
  snapshotId String                 @unique
  snapshot   TaskAcceptanceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)

  planVersionId String?
  /// For the repeat-window recompute and nothing else. Never rendered.
  clientId      String

  executionWorkflowKey  String?
  executionWorkflowHash String?
  executionKeyVersion   Int
  pricingPolicyVersion  String
  qualityPolicyVersion  String
  costCatalogVersion    String

  categoryId          String?
  unitsRequested      Int?
  verificationLevel   String?
  sensitiveData       Boolean?
  requiredAccessCount Int?

  // ── From the accepted plan (null when the task was quoted without one) ──
  plannedWorkerMinutes      Int?
  plannedReviewerMinutes    Int?
  plannedAutomatedStepCount Int?
  plannedHumanStepCount     Int?

  // ── From the quote as computed ──
  estimatedInternalCostLikelyCents       Int?
  estimatedInternalCostConservativeCents Int?
  estimatedWorkerPayoutCents             Int?
  estimatedWorkerMinutesAtQuote          Int?
  clientPriceCents                       Int

  // ── Modeled constants that entered the price (catalog, not plan) ──
  modeledReviewerMinutesAtQuote Int
  modeledReworkReservePctBps    Int
  modeledStripeFeePctBps        Int
  modeledStripeFeeFixedCents    Int
  modeledTargetMarginBps        Int

  calibrationLevelAtQuote       String?
  clientPriorCompletedTaskCount Int
  repeatWindowEndsAt            DateTime

  dataQualityFlags String[]
  createdAt        DateTime @default(now())

  @@index([clientId, repeatWindowEndsAt])
  @@index([executionWorkflowKey])
}

/**
 * EXPLICIT WORK SESSIONS — the only time measurement in the product. No
 * keyboard, mouse, screen or activity tracking of any kind: the user
 * starts, pauses, resumes and stops their own visible timer, timestamps are
 * server-side, and abandoned sessions are closed by a sweep with capped
 * seconds rather than silently growing. One OPEN session per
 * (task, user, role) — a partial unique index in the migration (SQL only:
 * Prisma cannot express partial uniques, same caveat as the HNSW index).
 */
model TaskWorkSession {
  id            String  @id @default(cuid())
  taskId        String
  task          Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workflowRunId String?

  /// Bare string, the editedByAdminId precedent — sessions are telemetry.
  userId String
  role   WorkSessionRole
  phase  WorkSessionPhase
  status WorkSessionStatus @default(active)

  startedAt     DateTime  @default(now())
  /// Set on resume; accumulation on pause/stop = now − (lastResumedAt ?? startedAt).
  lastResumedAt DateTime?
  endedAt       DateTime?

  accumulatedSeconds Int               @default(0)
  source             WorkSessionSource @default(timer)
  attemptNo          Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@index([userId, status])
}

/**
 * ONE STRUCTURED RECORD PER QC PASS. Raw counts by severity — no composite
 * score in 1C-α, so no critical error can ever hide behind a 95%.
 * reviewSequence follows the Submission.attemptNo motif; today the
 * application guard (updateMany on qcStatus "pending") makes it always 1,
 * and a future second opinion or dispute re-examination appends rather than
 * overwrites. rubricVersion IS the quality policy version.
 */
model TaskQualityReview {
  id            String     @id @default(cuid())
  taskId        String
  task          Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workflowRunId String?
  submissionId  String
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  reviewSequence Int
  /// Bare string (editedByAdminId precedent). The reviewer IS an admin
  /// today — Role has no REVIEWER; the plan-side enum is pre-provisioned.
  reviewerId     String
  attemptNo      Int
  rubricVersion  String
  outcome        QualityReviewOutcome

  totalUnits        Int?
  unitsChecked      Int?
  unitsCorrect      Int?
  unitsIncomplete   Int?
  unitsUnverifiable Int?

  criticalErrorCount       Int @default(0)
  majorErrorCount          Int @default(0)
  minorErrorCount          Int @default(0)
  duplicateCount           Int @default(0)
  invalidSourceCount       Int @default(0)
  missingSourceCount       Int @default(0)
  formattingErrorCount     Int @default(0)
  correctedByReviewerCount Int @default(0)

  /// Validated by the SAME zod schemas as Submission.deliveryMetrics.
  categoryMetrics Json?
  reviewerNotes   String?
  createdAt       DateTime @default(now())

  @@unique([submissionId, reviewSequence])
  @@index([taskId])
  @@index([reviewerId])
}

/**
 * THE CURRENT PROJECTION of a task's estimated-vs-actual record. Entirely
 * recomputable from source tables; upserted under a per-task advisory lock;
 * every significant change leaves an append-only
 * operational_actual_recomputed TaskEvent with before/after hashes — the
 * projection can be overwritten, the history of WHY it changed cannot.
 *
 * ALL MONEY AGGREGATES ARE BigInt: Prisma Int is 32-bit signed and
 * 2 147 483 647 micros is only $2,147.48 — a $500 payout in micros already
 * overflows it. Costs are named by PROVENANCE (booked / metered / modeled);
 * nothing here may ever be labeled a "real" reconciled provider cost.
 */
model TaskOperationalActual {
  id     String @id @default(cuid())
  taskId String @unique
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  snapshotId            String?
  workflowRunId         String?
  executionWorkflowKey  String?
  executionWorkflowHash String?
  pricingPolicyVersion  String?
  qualityPolicyVersion  String?

  outcomeClass TaskOutcomeClass?
  deliveredAt  DateTime?

  executionStartedAt      DateTime?
  executionFinishedAt     DateTime?
  automatedElapsedSeconds Int?
  workerActiveSeconds     Int?
  reviewerActiveSeconds   Int?
  revisionActiveSeconds   Int?

  unitsRequested             Int?
  unitsDiscovered            Int?
  unitsPrefilled             Int?
  unitsResolvedAutomatically Int?
  unitsSentToHuman           Int?
  unitsResolvedByHuman       Int?
  unitsUnresolved            Int?
  unitsCorrectedByReviewer   Int?
  automatedUnitRateBps       Int?
  exceptionRateBps           Int?

  // ── metered: measured quantity × OUR tariff table — not a bill ──
  aiCostMeteredMicros   BigInt @default(0)
  toolCostMeteredMicros BigInt @default(0)

  // ── modeled: assumptions, flagged on dataQualityFlags ──
  reviewerLaborModeledFromMeasuredTimeMicros BigInt?
  paymentFeeModeledMicros                    BigInt?

  // ── booked: real obligations recorded in our own tables ──
  workerPayoutCurrentLiabilityCents Int @default(0)
  workerPayoutPaidCents             Int @default(0)
  workerPayoutVoidedCents           Int @default(0)
  /// liability + paid. NOT a historical cumulative — amounts can be
  /// re-armed in place; history lives in payout_amount_rearmed events.
  workerPayoutNetIncurredCents      Int @default(0)

  bookedAndMeteredCostMicros BigInt @default(0)
  modeledCostAddonMicros     BigInt @default(0)
  allInCostWithModeledMicros BigInt @default(0)

  /// Null until money was actually received. An authorization is NOT revenue.
  recognizedRevenueMicros BigInt?

  grossMarginBookedMeteredMicros BigInt?
  grossMarginBookedMeteredBps    Int?
  grossMarginAllInModeledMicros  BigInt?
  grossMarginAllInModeledBps     Int?
  costVarianceMicros             BigInt?

  revisionRounds                  Int?
  passedQcFirstAttempt            Boolean?
  criticalErrorCount              Int?
  totalErrorCount                 Int?
  disputeOpened                   Boolean  @default(false)
  clientRevisionRequested         Boolean  @default(false)
  /// Revealed preference, NEVER labeled satisfaction: delivered, zero
  /// corrections asked, no dispute, window expired.
  clientAcceptedWithoutCorrection Boolean?
  /// Tri-state with honest censoring: null while the 90-day window is open.
  repeatWithin90Days              Boolean?

  eligibleForReliabilityStatistics         Boolean @default(false)
  eligibleForCostAndPerformanceCalibration Boolean @default(false)
  eligibleForMarginStatistics              Boolean @default(false)

  metricsCompletenessBps Int      @default(0)
  dataQualityFlags       String[]

  /// The cheap aggregate snapshot of every mutable source, re-taken under
  /// the advisory lock — counts alone cannot see an in-place mutation.
  inputFingerprint   String
  computedAt         DateTime
  computationVersion Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([executionWorkflowKey])
  @@index([outcomeClass])
}

/**
 * THE DERIVED PROFILE per execution workflow key — fully rebuilt on every
 * recompute, never incremental, so it can never diverge from the actuals.
 * Cost/performance distributions POOL across policy versions (a token costs
 * what it costs); QC metrics and estimate-variances live in the STRATA
 * table, per policy version. Recommendations read the ACTIVE policy's
 * stratum only and go null rather than fall back on pooled numbers.
 */
model WorkflowCalibrationProfile {
  id                    String  @id @default(cuid())
  executionWorkflowKey  String  @unique
  executionWorkflowHash String
  executionKeyVersion   Int
  categoryId            String?
  primitiveSignature    String

  sampleSizeReliability    Int @default(0)
  sampleSizeCostPerf       Int @default(0)
  sampleSizeMargin         Int @default(0)
  sampleSizeRepeatResolved Int @default(0)
  sampleSizeRecent         Int @default(0)

  calibrationLevel       CalibrationLevel @default(uncalibrated)
  metricsCompletenessBps Int?

  commercialSuccessRateBps    Int?
  technicalReliabilityRateBps Int?
  firstPassQcRateBps          Int?
  disputeRateBps              Int?
  revisionRateBps             Int?
  criticalErrorRateBps        Int?
  noCorrectionRateBps         Int?
  repeatWithin90dRateBps      Int?

  medianAutomatedUnitRateBps Int?
  p25AutomatedUnitRateBps    Int?
  p75AutomatedUnitRateBps    Int?
  medianExceptionRateBps     Int?

  medianAiCostPerUnitMicros   BigInt?
  p75AiCostPerUnitMicros      BigInt?
  medianToolCostPerUnitMicros BigInt?

  medianWorkerSecondsPerException Int?
  p75WorkerSecondsPerException    Int?
  medianReviewerSecondsPerUnit    Int?

  medianAllInCostMicros BigInt?
  p25AllInCostMicros    BigInt?
  p75AllInCostMicros    BigInt?
  p90AllInCostMicros    BigInt?

  medianGrossMarginAllInBps Int?
  p25GrossMarginAllInBps    Int?

  /// Per-outcome-class counts, closed vocabulary — survivorship bias made
  /// visible instead of filtered out.
  outcomeCounts Json?

  pricingPolicyVersions String[]
  qualityPolicyVersions String[]

  driftFlags                String[]
  recommendation            Json?
  recommendationGeneratedAt DateTime?

  lastExecutionAt    DateTime?
  lastComputedAt     DateTime
  computationVersion Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  strata WorkflowCalibrationStratum[]

  @@index([calibrationLevel])
}

/// Policy-stratified metrics: dimension "quality" per rubric version,
/// dimension "pricing" per pricing policy version. Typed columns, no
/// generic key-value blob for the load-bearing numbers.
model WorkflowCalibrationStratum {
  id            String                      @id @default(cuid())
  profileId     String
  profile       WorkflowCalibrationProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  dimension     CalibrationStratumDimension
  policyVersion String
  n             Int

  // quality dimension
  firstPassQcRateBps    Int?
  criticalErrorRateBps  Int?
  revisionRateBps       Int?
  errorCountsBySeverity Json?

  // pricing dimension — estimate-vs-actual only makes sense within one
  // policy, plus the cost distribution the recommendation prices from.
  medianCostVarianceBps   Int?
  medianPayoutVarianceBps Int?
  allInCostP75Micros      BigInt?
  allInCostP90Micros      BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, dimension, policyVersion])
}
