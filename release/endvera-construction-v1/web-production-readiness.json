  "deploymentBlockers": [
    {"code":"PUBLIC_PRODUCTION_ORIGIN","ownerClass":"FOUNDER_OR_RELEASE_OWNER","evidenceRequired":"Approved public domain and canonical HTTPS origin"},
    {"code":"PRODUCTION_DATABASE","ownerClass":"AUTHORIZED_RELEASE_OPERATOR","evidenceRequired":"Provisioned database, forward-only migration and restore evidence"},
    {"code":"AUTH_SECRET_CUSTODY","ownerClass":"AUTHORIZED_RELEASE_OPERATOR","evidenceRequired":"Managed production auth secret reference and rotation owner"},
    {"code":"OBJECT_STORAGE","ownerClass":"AUTHORIZED_RELEASE_OPERATOR","evidenceRequired":"Bounded object storage, lifecycle and recovery evidence"},
    {"code":"PRODUCTION_FILE_SCANNER","ownerClass":"AUTHORIZED_RELEASE_OPERATOR","evidenceRequired":"Fail-closed scanning provider and observed clean/malicious fixtures"},
    {"code":"DNS_AND_TLS","ownerClass":"AUTHORIZED_RELEASE_OPERATOR","evidenceRequired":"Verified DNS, TLS, security headers and rollback target"}
  ],
  "capabilityBlockers": [
    {"code":"AI_PROVIDER_ACTIVATION","state":"SEPARATE_AUTHORITY_REQUIRED"},
    {"code":"GOOGLE_OAUTH_ACTIVATION","state":"SEPARATE_AUTHORITY_REQUIRED"},
    {"code":"EMAIL_PROVIDER_ACTIVATION","state":"SEPARATE_AUTHORITY_REQUIRED"},
    {"code":"PAYMENT_PROVIDER_ACTIVATION","state":"SEPARATE_AUTHORITY_REQUIRED"},
    {"code":"MESSAGING_AND_VOICE_ACTIVATION","state":"SEPARATE_AUTHORITY_REQUIRED"}
  ],
  "smokeContract": {
    "beforePromotion": ["/api/health", "/", "/construction", "/privacy", "/security", "/construction/support", "/login"],
    "rollbackTriggers": ["HEALTH_UNAVAILABLE", "AUTH_CALLBACK_FAILURE", "DATABASE_MIGRATION_FAILURE", "CROSS_TENANT_SIGNAL", "EXTERNAL_EFFECT_WITHOUT_AUTHORITY"],
    "rollbackEvidenceRequired": ["previousImmutableBuildId", "databaseCompatibilityDecision", "incidentOwner", "postRollbackHealth"]
