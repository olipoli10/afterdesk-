    {"path":"/terms","kind":"LEGAL","sourcePath":"src/app/terms/page.tsx"},
    {"path":"/acceptable-use","kind":"LEGAL","sourcePath":"src/app/acceptable-use/page.tsx"},
    {"path":"/construction/support","kind":"SUPPORT","sourcePath":"src/app/construction/support/page.tsx"},
    {"path":"/login","kind":"AUTH","sourcePath":"src/app/(public)/login/page.tsx"},
    {"path":"/register","kind":"AUTH","sourcePath":"src/app/(public)/register/page.tsx"},
    {"path":"/api/auth/[...all]","kind":"AUTH_API","sourcePath":"src/app/api/auth/[...all]/route.ts"},
    {"path":"/api/health","kind":"LIVENESS","sourcePath":"src/app/api/health/route.ts"}
